"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import cudf, cuml\nprint(f\"cuDF  version : {cudf.__version__}\")","key":"cCeN2IxTLu"},{"type":"output","id":"E_hkkwnV3XnwET_S5Y4B1","data":[{"name":"stdout","output_type":"stream","text":"cuDF  version : 25.04.00\n"}],"key":"vYWCMd1jMq"}],"key":"z0uG5KGLeh"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"cuDF — pandas-compatible DataFrames on GPU","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"HHEAPjWt7D"}],"identifier":"cudf-pandas-compatible-dataframes-on-gpu","label":"cuDF — pandas-compatible DataFrames on GPU","html_id":"cudf-pandas-compatible-dataframes-on-gpu","implicit":true,"key":"RnfMrK5kcF"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"We compare a ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"aunCOKVLyb"},{"type":"inlineCode","value":"groupby().mean()","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"P2Nz7waes9"},{"type":"text","value":" on pandas vs cuDF across several dataset sizes.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"Ri05MVlVSx"}],"key":"p15jJnzjSY"}],"key":"q2pwEhp7Gq"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import pandas as pd\nimport matplotlib.pyplot as plt\n\nsizes = [100_000, 500_000, 2_000_000, 10_000_000]\ncpu_t, gpu_t = [], []\nfor n in sizes:\n    data = {\n        \"x\": np.random.randn(n),\n        \"y\": np.random.randn(n),\n        \"group\": np.random.randint(0, 100, n),\n    }\n    df_pd  = pd.DataFrame(data)\n    df_gpu = cudf.DataFrame(data)\n\n    t0 = time.perf_counter()\n    _ = df_pd.groupby(\"group\")[[\"x\", \"y\"]].mean()\n    cpu_t.append(time.perf_counter() - t0)\n\n    # warm-up\n    _ = df_gpu.groupby(\"group\")[[\"x\", \"y\"]].mean().to_pandas()\n    t0 = time.perf_counter()\n    _ = df_gpu.groupby(\"group\")[[\"x\", \"y\"]].mean().to_pandas()\n    gpu_t.append(time.perf_counter() - t0)\n    print(f\"n={n:>10,d}  pandas={cpu_t[-1]*1000:8.1f} ms  cuDF={gpu_t[-1]*1000:7.1f} ms  speedup={cpu_t[-1]/gpu_t[-1]:5.1f}x\")\n\nfig, axes = plt.subplots(1, 2, figsize=(11, 4))\naxes[0].loglog(sizes, [t*1000 for t in cpu_t], \"o-\", label=\"pandas\")\naxes[0].loglog(sizes, [t*1000 for t in gpu_t], \"s-\", label=\"cuDF\")\naxes[0].set_xlabel(\"# rows\"); axes[0].set_ylabel(\"groupby time (ms)\")\naxes[0].set_title(\"groupby().mean()\"); axes[0].legend(); axes[0].grid(True, which=\"both\", alpha=0.3)\naxes[1].semilogx(sizes, [c/g for c, g in zip(cpu_t, gpu_t)], \"o-\", color=\"darkgreen\")\naxes[1].set_xlabel(\"# rows\"); axes[1].set_ylabel(\"Speedup (pandas / cuDF)\")\naxes[1].set_title(\"GPU speedup vs CPU\"); axes[1].grid(True, which=\"both\", alpha=0.3)\nplt.tight_layout(); plt.show()","key":"eDqXFxyGql"},{"type":"output","id":"_tty_DBzoxPDP3FBPeU5p","data":[{"name":"stdout","output_type":"stream","text":"n=   100,000  pandas=     4.0 ms  cuDF=    2.9 ms  speedup=  1.4x\nn=   500,000  pandas=    11.4 ms  cuDF=    4.8 ms  speedup=  2.4x\nn= 2,000,000  pandas=    37.7 ms  cuDF=    4.7 ms  speedup=  8.0x\nn=10,000,000  pandas=   190.9 ms  cuDF=   12.8 ms  speedup= 15.0x\n"},{"output_type":"display_data","metadata":{},"data":{"image/png":{"content_type":"image/png","hash":"2e4eac3e8bf031352bc2df3164edfbe4","path":"/DestinE-DataLake-Staging-Gallery/build/2e4eac3e8bf031352bc2df3164edfbe4.png"},"text/plain":{"content":"<Figure size 1100x400 with 2 Axes>","content_type":"text/plain"}}}],"key":"CrGII3z9b4"}],"key":"LSRcObUzjv"}],"key":"yMfZZlXUwd"},"references":{"cite":{"order":[],"data":{}}},"footer":{},"domain":"http://localhost:3000"}