,"data":[],"visibility":"show","key":"oe8OV9BQBH"}],"visibility":"show","key":"MA4PVhVvkt"},{"type":"block","kind":"notebook-code","data":{"tags":[]},"children":[{"type":"code","lang":"python","executable":true,"value":"# Crunch the results\nfiltered_results = products_first_page.crunch(FilterProperty({\"eo:cloud_cover\": 20, \"operator\" : \"lt\"}))\n\nprint(f\"Got now {len(filtered_results)} products after filtering by cloudCover.\")","visibility":"show","key":"dhhTX2f84a"},{"type":"output","id":"4vTI-RqZhS-5noDxNMZLi","data":[{"name":"stdout","output_type":"stream","text":"Got now 22 products after filtering by cloudCover.\n"}],"visibility":"show","key":"E54tm8Xoh3"}],"visibility":"show","key":"YbU9lheeUu"},{"type":"block","kind":"notebook-code","data":{"tags":[]},"children":[{"type":"code","lang":"python","executable":true,"value":"filtered_products = filtered_results.crunch(\n    FilterOverlap(dict(contains=True)),\n    geometry=small_geom\n)\nprint(f\"Got now {len(filtered_products)} products after filtering by geometry.\")","visibility":"show","key":"iQ6SuWXZk2"},{"type":"output","id":"xxqJNEU4R8zXfE-71-feo","data":[{"name":"stdout","output_type":"stream","text":"Got now 1 products after filtering by geometry.\n"}],"visibility":"show","key":"BBorlUnANO"}],"visibility":"show","key":"PoYxXjqXji"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Let’s use the function defined to see the area defined on a map (red) together with the initial results (blue) filtered by cloud coverage and geometry (green).","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"rtw2QCMzae"}],"key":"LRkjvdEVNh"}],"key":"ka2rqpCrwI"},{"type":"block","kind":"notebook-code","data":{"tags":[]},"children":[{"type":"code","lang":"python","executable":true,"value":"fmap = create_search_result_map(products_first_page, search_geometry)\n# C