,"data":[],"visibility":"show","key":"qbEfizj7SN"}],"visibility":"show","key":"orpPEG2se8"},{"type":"block","kind":"notebook-code","data":{"tags":[]},"children":[{"type":"code","lang":"python","executable":true,"value":"# Crunch the results\nfiltered_results = products_first_page.crunch(FilterProperty({\"eo:cloud_cover\": 20, \"operator\" : \"lt\"}))\n\nprint(f\"Got now {len(filtered_results)} products after filtering by cloudCover.\")","visibility":"show","key":"Dh7fRS0hHA"},{"type":"output","id":"cbj05dbOXR54jVjr87mEu","data":[{"name":"stdout","output_type":"stream","text":"Got now 22 products after filtering by cloudCover.\n"}],"visibility":"show","key":"V7GGgRCVf6"}],"visibility":"show","key":"AlsqatcwM5"},{"type":"block","kind":"notebook-code","data":{"tags":[]},"children":[{"type":"code","lang":"python","executable":true,"value":"filtered_products = filtered_results.crunch(\n    FilterOverlap(dict(contains=True)),\n    geometry=small_geom\n)\nprint(f\"Got now {len(filtered_products)} products after filtering by geometry.\")","visibility":"show","key":"LoqFY39AH4"},{"type":"output","id":"n2f6PxoLD6MDSF3GmwPyq","data":[{"name":"stdout","output_type":"stream","text":"Got now 1 products after filtering by geometry.\n"}],"visibility":"show","key":"Za4AheZjvL"}],"visibility":"show","key":"Gm157l2UM9"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Let’s use the function defined to see the area defined on a map (red) together with the initial results (blue) filtered by cloud coverage and geometry (green).","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"pJfhsOWPCO"}],"key":"Islu5udtxV"}],"key":"NUjEJ9pARz"},{"type":"block","kind":"notebook-code","data":{"tags":[]},"children":[{"type":"code","lang":"python","executable":true,"value":"fmap = create_search_result_map(products_first_page, search_geometry)\n# C