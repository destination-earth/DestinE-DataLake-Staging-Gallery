,"data":[],"visibility":"show","key":"i3iGPSpMjy"}],"visibility":"show","key":"AU6YcEEvTw"},{"type":"block","kind":"notebook-code","data":{"tags":[]},"children":[{"type":"code","lang":"python","executable":true,"value":"# Crunch the results\nfiltered_results = products_first_page.crunch(FilterProperty({\"eo:cloud_cover\": 20, \"operator\" : \"lt\"}))\n\nprint(f\"Got now {len(filtered_results)} products after filtering by cloudCover.\")","visibility":"show","key":"HbkBtshOr1"},{"type":"output","id":"zARq15YLnvkVapdqc4PYo","data":[{"name":"stdout","output_type":"stream","text":"Got now 22 products after filtering by cloudCover.\n"}],"visibility":"show","key":"tJE1hVLG5w"}],"visibility":"show","key":"j8Y2f5jlzt"},{"type":"block","kind":"notebook-code","data":{"tags":[]},"children":[{"type":"code","lang":"python","executable":true,"value":"filtered_products = filtered_results.crunch(\n    FilterOverlap(dict(contains=True)),\n    geometry=small_geom\n)\nprint(f\"Got now {len(filtered_products)} products after filtering by geometry.\")","visibility":"show","key":"WlnsRoYPWE"},{"type":"output","id":"-DEnLSsnHm9Rw4Tt9QxF_","data":[{"name":"stdout","output_type":"stream","text":"Got now 1 products after filtering by geometry.\n"}],"visibility":"show","key":"nAPXU7tEPp"}],"visibility":"show","key":"y6z9YNX7CP"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Let’s use the function defined to see the area defined on a map (red) together with the initial results (blue) filtered by cloud coverage and geometry (green).","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"BXDEL4cuQq"}],"key":"Ac65kKnOur"}],"key":"L945xUv2kc"},{"type":"block","kind":"notebook-code","data":{"tags":[]},"children":[{"type":"code","lang":"python","executable":true,"value":"fmap = create_search_result_map(products_first_page, search_geometry)\n# C