y":"dPT28a2iEB"}],"visibility":"show","key":"iDcDVVD5wv"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Let’s define now a smaller area around the mount Etna and a function to see the area on a map together with the results","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"VI7a0Q3vy4"}],"key":"FFfq8rSlyS"}],"key":"Xkc7ajVTbA"},{"type":"block","kind":"notebook-code","data":{"tags":[]},"children":[{"type":"code","lang":"python","executable":true,"value":"from eodag.crunch import FilterProperty\nfrom eodag.crunch import FilterOverlap\nimport shapely\nimport folium\nfrom shapely.geometry import Polygon\n\nsmall_geom = Polygon([[15.1, 37.7], [15.5, 37.7], [15.1, 37.75], [15.1, 37.75], [15.1, 37.7]])\n\nsmaller_area = {\"lonmin\": 15.1, \"latmin\": 37.7, \"lonmax\": 15.5, \"latmax\": 37.75}\n\nsearch_geometry = shapely.geometry.box(\n    smaller_area[\"lonmin\"],\n    smaller_area[\"latmin\"],\n    smaller_area[\"lonmax\"],\n    smaller_area[\"latmax\"],\n)","visibility":"show","key":"eTouDs9Kb2"},{"type":"output","id":"RcBH6c25FGQGvB7RIEslM","data":[],"visibility":"show","key":"sm3xnf1cwT"}],"visibility":"show","key":"sUcI7J8E3o"},{"type":"block","kind":"notebook-code","data":{"tags":[]},"children":[{"type":"code","lang":"python","executable":true,"value":"\ndef create_search_result_map(search_results, extent):\n    \"\"\"Small utility to create an interactive map with folium\n    that displays an extent in red and EO Producs in blue\"\"\"\n    fmap = folium.Map([38, 14], zoom_start=7,\n            width=1000,\n            height=500)\n    folium.GeoJson(\n        extent,\n        style_function=lambda x: dict(color=\"red\")\n    ).add_to(fmap)\n    folium.GeoJson(\n        search_results\n    ).add_to(fmap)\n    return fmap","visibility":"show","key":"UCQj1WBgF3"},{"type":"output","id":"1FOkI4Yj8cnqTCqUGWC30","data":[],"visibility":"show","key":"KGHDRTuppp"}],"visibility":"show","key":"EGWpsu09oO"},{"type":"block","kind":"notebook-code","data":{"tags":[]},"children":[{"type":"code","lang":"python","executable":true,"value":"# Crunch the results\nfiltered_results = products_first_page.crunch(FilterProperty({\"eo:cloud_cover\": 20, \"operator\" : \"lt\"}))\n\nprint(f\"Got now {len(filtered_results)} products after filtering by cloudCover.\")","visibility":"show","key":"jNWAmRNmZh"},{"type":"output","id":"lG_CRZYCdIJK9JlPU5eEG","data":[{"name":"stdout","output_type":"stream","text":"Got now 22 products after filtering by cloudCover.\n"}],"visibility":"show","key":"tR8YbSfdS7"}],"visibility":"show","key":"cXVqwxyoxr"},{"type":"block","kind":"notebook-code","data":{"tags":[]},"children":[{"type":"code","lang":"python","executable":true,"value":"filtered_products = filtered_results.crunch(\n    FilterOverlap(dict(contains=True)),\n    geometry=small_geom\n)\nprint(f\"Got now {len(filtered_products)} products after filtering by geometry.\")","visibility":"show","key":"nx6MrTN68t"},{"type":"output","id":"gsfOCmxXcDNUG8f48WKA-","data":[{"name":"stdout","output_type":"stream","text":"Got now 1 products after filtering by geometry.\n"}],"visibility":"show","key":"ImWEawBDmL"}],"visibility":"show","key":"M23sKa3PhA"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Let’s use the function defined to see the area defined on a map (red) together with the initial results (blue) filtered by cloud coverage and geometry (green).","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"vm96DRy4TN"}],"key":"nRzyGiuqqK"}],"key":"MrozgENpS1"},{"type":"block","kind":"notebook-code","data":{"tags":[]},"children":[{"type":"code","lang":"python","executable":true,"value":"fmap = create_search_result_map(products_first_page, search_geometry)\n# C