time\"].dt.year\n    df[\"month\"] = df[\"time\"].dt.month\n\n    df[\"city\"] = city\n    \n    return df","key":"AjGBBU7asr"},{"type":"output","id":"7oRNTCFzPAmFlY_WpP8tK","data":[],"key":"omqlty3ijH"}],"key":"JmaNq6KE3G"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"rome_2026 = load_covjson(\"2t_rome_2026.covjson\", \"Rome_2026\")\nrome_2036 = load_covjson(\"2t_rome_2036.covjson\", \"Rome_2036\")\n\ndf = pd.concat([rome_2026,rome_2036])\n","key":"pK2dyOdIwO"},{"type":"output","id":"82L00HaSY6GARaNbRyEMd","data":[],"key":"QkTmyxkfxd"}],"key":"mTOVwK0bPC"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Two years comparison - 2026 - 2036","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"wLYp4bKbkM"}],"identifier":"two-years-comparison-2026-2036","label":"Two years comparison - 2026 - 2036","html_id":"two-years-comparison-2026-2036","implicit":true,"key":"B9QrJtD7Pr"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"Differences between years to check if one year is systematically warmer, if both years follow the same seasonal pattern or if there are shifts (e.g. earlier warming)","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"QwBEgO86Bo"}],"key":"ypF8CBmpEc"}],"key":"q1vh6y1UBu"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import matplotlib.pyplot as plt\n\nmonthly = df.groupby([\"city\", \"month\"])[\"value_C\"].mean().reset_index() #seasonal cycle\n\nfor city in [\"Rome_2026\", \"Rome_2036\"]:\n    subset = monthly[monthly[\"city\"] == city]\n    plt.plot(subset[\"month\"], subset[\"value_C\"], marker=\"o\", label=city)\n\nplt.title(\"Projected Changes in Monthly Mean Temperature — Rome (2026 vs 2036)\")\nplt.xlabel(\"Month\")\nplt.ylabel(\"Temperature (°C)\")\nplt.legend()\nplt.grid()\nplt.show()","key":"kgL50MtPpG"},{"type":"output","id":"GADhc4AMzSpDQLG8Odv8u","data":[{"output_type":"display_data","metadata":{},"data":{"image/png":{"content_type":"image/png","hash":"4fc81a800f613bcf4953102625330b04","path":"/DestinE-DataLake-Staging-Gallery/build/4fc81a800f613bcf4953102625330b04.png"},"text/plain":{"content":"<Figure size 640x480 with 1 Axes>","content_type":"text/plain"}}}],"key":"ojG3g6IQkp"}],"key":"zUJCLltuvP"}],"key":"zIS0p3rfT2"},"references":{"cite":{"order":[],"data":{}}},"footer":{},"domain":"http://localhost:3000"}