 = plt.imshow(result, transform=crs, extent=crs.bounds, origin='upper')\ncbar = plt.colorbar()","visibility":"show","key":"Q0Nc0nwQD1"},{"type":"output","id":"KZh3FQiD32S5ZWtxby-Ut","data":[{"output_type":"display_data","metadata":{},"data":{"image/png":{"content_type":"image/png","hash":"626a8726057eb4e7aa207cb83a9d896a","path":"/DestinE-DataLake-Staging-Gallery/build/626a8726057eb4e7aa207cb83a9d896a.png"},"text/plain":{"content":"<Figure size 640x480 with 2 Axes>","content_type":"text/plain"}}}],"visibility":"show","key":"lodkmdaGjt"}],"visibility":"show","key":"Nvu4LWwoPg"}],"key":"BrK1CUBw7G"},"references":{"cite":{"order":[],"data":{}}},"footer":{},"domain":"http://localhost:3000"}