n            for data in response.iter_content(1024):\n                progress_bar.update(len(data))\n                f.write(data)","visibility":"show","key":"XxaErJHWuC"},{"type":"output","id":"noblFnqXg2bQvFKosyAEm","data":[{"name":"stdout","output_type":"stream","text":"https://hda-download.central.data.destination-earth.eu/data/external_fdp/EO.EUM.DAT.SENTINEL-3.OL_1_ERR___/S3B_OL_1_ERR____20240625T083313_20240625T091737_20240921T223114_2664_094_278______MAR_R_NT_004/downloadLink\nS3B_OL_1_ERR____20240625T083313_20240625T091737_20240921T223114_2664_094_278______MAR_R_NT_004\ndownloading S3B_OL_1_ERR____20240625T083313_20240625T091737_20240921T223114_2664_094_278______MAR_R_NT_004\n"},{"name":"stderr","output_type":"stream","text":"928MB [00:02, 426MB/s] \n"}],"visibility":"show","key":"Xqn49lbjxL"}],"visibility":"show","key":"dZQor8V4eV"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":4,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Unfold the product","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"eZYXIlCZYc"}],"identifier":"unfold-the-product","label":"Unfold the product","html_id":"unfold-the-product","implicit":true,"key":"Dh2M8V4ps2"}],"key":"XlKNFNscvS"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import zipfile\nimport os\nimport shutil\nimport uuid\n\n# 1) Create a temporary extraction directory\ntmp_dir = f\"tmp_extract_{uuid.uuid4().hex}\"\nos.makedirs(tmp_dir, exist_ok=True)\n\n# 2) Extract zip content safely inside the temporary folder\nwith zipfile.ZipFile(filename, \"r\") as z:\n    z.extractall(tmp_dir)\n\n# 3) Identify the Sentinel-3 product folder inside the temp folder\nentries = os.listdir(tmp_dir)\nproduct_dirs = [e for e in entries if os.path.isdir(os.path.join(tmp_dir, e))]\n\nif not product_dirs:\n    shutil.rmtree(tmp_dir, ignore_errors=True)\n    rai