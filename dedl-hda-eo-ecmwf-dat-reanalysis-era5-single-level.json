nt","data":{"tags":[]},"children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Order data","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"XW4oBEPcmY"}],"identifier":"order-data","label":"Order data","html_id":"order-data","implicit":true,"key":"em6NGQPdbg"},{"type":"paragraph","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"text","value":"We have now all the information to order the data.","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"UUq9vTJ7Cq"}],"key":"MAlUviTMDI"},{"type":"paragraph","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"children":[{"type":"text","value":"From the search results we know that the product is orderable and offline, we then need to order the product we searched for.","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"key":"zlDb2DDBaa"}],"key":"SizxecrLgH"}],"visibility":"show","key":"OM3EAzeRLX"},{"type":"block","kind":"notebook-code","data":{"tags":[]},"children":[{"type":"code","lang":"python","executable":true,"value":"response = requests.post(href, json=body, headers=auth_headers)\n\nif response.status_code != 200:\n    print(response.content)\nresponse.raise_for_status()\n\nordered_item = response.json()\n\nproduct_id = ordered_item[\"id\"]\nstorage_tier = ordered_item[\"properties\"].get(\"storage:tier\", \"online\")\norder_status = ordered_item[\"properties\"].get(\"order:status\", \"unknown\")\nfederation_backend = ordered_item[\"properties\"].get(\"federation:backends\", [None])[0]\n\nprint(f\"Product ordered: {product_id}\")\nprint(f\"Provider: {federation_backend}\")\nprint(f\"Storage tier: {storage_tier} (product must have storage tier \\\"online\\\" to be downloadable)\")\nprint(f\"Order status: {order_status}\")","visibility":"show","key":"itMVegDEcr"},{"type":"output","id":"47dhh9zZWmJp