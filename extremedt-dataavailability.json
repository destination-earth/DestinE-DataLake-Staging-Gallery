r(pyaviso))\n","key":"a3f3krSW3K"},{"type":"output","id":"n6Xx9ejh6eG8qN_8WkeEX","data":[{"name":"stdout","output_type":"stream","text":"1.0.2\n['HOME_FOLDER', 'NotificationManager', 'Queue', 'SYSTEM_FOLDER', '__builtins__', '__cached__', '__doc__', '__file__', '__loader__', '__name__', '__package__', '__path__', '__spec__', '__version__', 'authentication', 'custom_exceptions', 'engine', 'event_listeners', 'exit_channel', 'logger', 'logging', 'notification_manager', 'triggers', 'user_config', 'version']\n"}],"key":"MGYyjZahxv"}],"key":"vF8hR1VQ54"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"children":[{"type":"text","value":"Import pyaviso","key":"vMcUhzXvjP"}],"identifier":"import-pyaviso","label":"Import pyaviso","html_id":"import-pyaviso","implicit":true,"key":"MHSaZ00Md2"},{"type":"paragraph","children":[{"type":"text","value":"Import pyaviso and other useful libraries. Defining constants and functions.","key":"qBaDNS4CGo"}],"key":"EqvKm3eGdh"}],"key":"dFgLtbJvCQ"},{"type":"block","kind":"notebook-code","data":{"tags":[]},"children":[{"type":"code","lang":"python","executable":true,"value":"import sys\n\nfrom datetime import datetime, timedelta\nfrom pprint import pprint as pp\n\nfrom pyaviso import NotificationManager, user_config","visibility":"show","key":"VTs03REGAB"},{"type":"output","id":"qmwiNDuRFP1qgS1u0xZTD","data":[],"visibility":"show","key":"JVKWngnYYp"}],"visibility":"show","key":"UZK5Qzqm9v"},{"type":"block","kind":"notebook-code","data":{"tags":[]},"children":[{"type":"code","lang":"python","executable":true,"value":"LISTENER_EVENT = \"data\"  # Event for the listener, options are mars and dissemination\nTRIGGER_TYPE = \"function\"  # Type of trigger for the listener","visibility":"show","key":"VvMWZqvWzC"},{"type":"output","id":"lV3e75c9TtgqGTQCXL1no","data":[],"visibility":"show","key":"FwYeYFYAm8"}],"visibility":"show","key":"v30xVU7aRs"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"children":[{"type":"text","value":"Defining the data to be notified","key":"BWWRUAKiVf"}],"identifier":"defining-the-data-to-be-notified","label":"Defining the data to be notified","html_id":"defining-the-data-to-be-notified","implicit":true,"key":"dgFyxJT5m4"},{"type":"paragraph","children":[{"type":"text","value":"The following request describes the data whose availability we want to be notified","key":"yAB9mJknNP"}],"key":"DTSJCrYHhW"}],"key":"fQbZFEAFPL"},{"type":"block","kind":"notebook-code","data":{"tags":[]},"children":[{"type":"code","lang":"python","executable":true,"value":"REQUEST = {\n    \"class\": \"d1\",\n    \"expver\": \"0001\",\n    \"stream\": \"wave\",\n    \"type\": \"fc\",\n    \"time\": \"00\",\n    \"step\": \"0\",\n    \"levtype\": \"sfc\",\n#    \"levelist\": \"\",\n#    \"param\": \"168\"   \n}  # Request configuration for the listener\n","visibility":"show","key":"kggx8AGUoW"},{"type":"output","id":"itUCnnTyBBDuULTJUZXPk","data":[],"visibility":"show","key":"Yd2mQa0Rtu"}],"visibility":"show","key":"dNu3du4VmK"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"children":[{"type":"text","value":"Aviso configuration","key":"chU2LqPRQJ"}],"identifier":"aviso-configuration","label":"Aviso configuration","html_id":"aviso-configuration","implicit":true,"key":"rz1csBU5xL"}],"key":"uJfDUjMRd5"},{"type":"block","kind":"notebook-code","data":{"tags":[]},"children":[{"type":"code","lang":"python","executable":true,"value":"CONFIG = {\n    \"notification_engine\": {\n        \"host\": \"aviso.lumi.apps.dte.destination-earth.eu\",\n        \"port\": 443,\n        \"https\": True,\n    },\n    \"configuration_engine\": {\n        \"host\": \"aviso.lumi.apps.dte.destination-earth.eu\",\n        \"port\": 443,\n        \"https\": True,\n    },\n    \"schema_parser\": \"generic\",\n    \"remote_schema\": True,\n    \"auth_type\": \"none\",\n    \"quiet\" : True\n}  # manually defined configuration\n","visibility":"show","key":"LXpHHmyYcO"},{"type":"output","id":"sfanjqxwAy3074vcSQK4F","data":[],"visibility":"show","key":"MFVAqdNKoX"}],"visibility":"show","key":"OuM2emHby9"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"children":[{"type":"text","value":"Searching for notifications","key":"oYVP5G8JH5"}],"identifier":"searching-for-notifications","label":"Searching for notifications","html_id":"searching-for-notifications","implicit":true,"key":"ZR3Y6Ow2n2"},{"type":"paragraph","children":[{"type":"text","value":"Ssearching for notifications where available.","key":"jCLrPLFTjS"}],"key":"vUVyIaz3jn"}],"key":"zjpKPOL8qe"},{"type":"block","kind":"notebook-code","data":{"tags":[]},"children":[{"type":"code","lang":"python","executable":true,"value":"\n\nEND_DATE = datetime.now()\nSTART_DATE = END_DATE - timedelta(days=14)\n","visibility":"show","key":"PjeN3xPd4w"},{"type":"output","id":"XACQyiZl-ohU0uuNzODkQ","data":[],"visibility":"show","key":"rxhdWhYCQf"}],"visibility":"show","key":"JHtHoY8Kbc"},{"type":"block","kind":"notebook-code","data":{"tags":[]},"children":[{"type":"code","lang":"python","executable":true,"value":"def triggered_function(notification):\n    \"\"\"\n    Function for the listener to trigger.\n    \"\"\"\n    \n    #pp(notification)\n    # Access the date field\n    date_str = notification['request']['date']    \n\n    # Convert the date string to a datetime object\n    date_obj = datetime.strptime(date_str, '%Y%m%d')\n    formatted_date = date_obj.strftime('%Y-%m-%d')\n    pp(\"ExtremeDT data available=>\" + formatted_date)\n    \n    ","visibility":"show","key":"HRemQEJyNC"},{"type":"output","id":"_jfNB2Rl27pIUWp0EqoaE","data":[],"visibility":"show","key":"E9XFvLB2at"}],"visibility":"show","key":"IPj3ORhLi8"},{"type":"block","kind":"notebook-code","data":{"tags":[]},"children":[{"type":"code","lang":"python","executable":true,"value":"def create_hist_listener():\n    \"\"\"\n    Creates and returns a listener configuration.\n    \"\"\"\n\n    trigger = {\n        \"type\": TRIGGER_TYPE,\n        \"function\": triggered_function,\n    }  # Define the trigger for the listener\n    \n    # Return the complete listener configuration\n    return {\"event\": LISTENER_EVENT, \"request\": REQUEST, \"triggers\": [trigger]}\n","visibility":"show","key":"Qim6KYcTUb"},{"type":"output","id":"V9iwpqZHuyXTTA9MD4l5Q","data":[],"visibility":"show","key":"bkCamTnAxj"}],"visibility":"show","key":"XmdoAx3qKy"},{"type":"block","kind":"notebook-code","data":{"tags":[]},"children":[{"type":"code","lang":"python","executable":true,"value":"try:\n    listener = create_hist_listener()  # Create listener configuration\n    listeners_config = {\"listeners\": [listener]}  # Define listeners configuration\n    config = user_config.UserConfig(**CONFIG)\n    print(\"loaded config:\")\n    pp(CONFIG)\n    nmh = NotificationManager()  # Initialize the NotificationManager\n\n    nmh.listen(\n        listeners=listeners_config, from_date=START_DATE,to_date=END_DATE, config=config\n    )  # Start listening\nexcept Exception as e:\n    print(f\"Failed to initialize the Notification Manager: {e}\")","visibility":"show","key":"CBPuJ8iJsK"},{"type":"output","id":"XGF7WcDYT81yEcm7VK4W7","data":[{"name":"stdout","output_type":"stream","text":"loaded config:\n{'auth_type': 'none',\n 'configuration_engine': {'host': 'aviso.lumi.apps.dte.destination-earth.eu',\n                          'https': True,\n                          'port': 443},\n 'notification_engine': {'host': 'aviso.lumi.apps.dte.destination-earth.eu',\n                         'https': True,\n                         'port': 443},\n 'quiet': True,\n 'remote_schema': True,\n 'schema_parser': 'generic'}\n'ExtremeDT data available=>2026-07-27'\n'ExtremeDT data available=>2026-07-26'\n'ExtremeDT data available=>2026-07-25'\n'ExtremeDT data available=>2026-07-24'\n'ExtremeDT data available=>2026-07-23'\n'ExtremeDT data available=>2026-07-22'\n'ExtremeDT da