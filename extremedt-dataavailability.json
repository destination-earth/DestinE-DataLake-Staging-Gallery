ing","depth":2,"children":[{"type":"text","value":"Defining the data to be notified","key":"aRWEGYA54d"}],"identifier":"defining-the-data-to-be-notified","label":"Defining the data to be notified","html_id":"defining-the-data-to-be-notified","implicit":true,"key":"Tq7MWFDsaJ"},{"type":"paragraph","children":[{"type":"text","value":"The following request describes the data whose availability we want to be notified","key":"QQs2dntkkw"}],"key":"CdZR69GWgV"}],"key":"JmiakCEAfB"},{"type":"block","kind":"notebook-code","data":{"tags":[]},"children":[{"type":"code","lang":"python","executable":true,"value":"REQUEST = {\n    \"class\": \"d1\",\n    \"expver\": \"0001\",\n    \"stream\": \"wave\",\n    \"type\": \"fc\",\n    \"time\": \"00\",\n    \"step\": \"0\",\n    \"levtype\": \"sfc\",\n#    \"levelist\": \"\",\n#    \"param\": \"168\"   \n}  # Request configuration for the listener\n","visibility":"show","key":"Vgdv2WsU9C"},{"type":"output","id":"0mZh0FypDVn_m65FoQSni","data":[],"visibility":"show","key":"CXH0ZXGsvV"}],"visibility":"show","key":"fU79wk6wWQ"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"children":[{"type":"text","value":"Aviso configuration","key":"bCbg8Iwnqb"}],"identifier":"aviso-configuration","label":"Aviso configuration","html_id":"aviso-configuration","implicit":true,"key":"SgdExGnR4L"}],"key":"FkJcczBQWZ"},{"type":"block","kind":"notebook-code","data":{"tags":[]},"children":[{"type":"code","lang":"python","executable":true,"value":"CONFIG = {\n    \"notification_engine\": {\n        \"host\": \"aviso.lumi.apps.dte.destination-earth.eu\",\n        \"port\": 443,\n        \"https\": True,\n    },\n    \"configuration_engine\": {\n        \"host\": \"aviso.lumi.apps.dte.destination-earth.eu\",\n        \"port\": 443,\n        \"https\": True,\n    },\n    \"schema_parser\": \"generic\",\n    \"remote_schema\": True,\n    \"auth_type\": \"none\",\n    \"quiet\" : True\n}  # manually defined configuration\n","visibility":"show","key":"K105ldaeRg"},{"type":"output","id":"PxofRPd-zAIAa8BcIZTpg","data":[],"visibility":"show","key":"uoNB7mln5Q"}],"visibility":"show","key":"KjaH3Rkjlo"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"children":[{"type":"text","value":"Searching for notifications","key":"yvUPhuw6CG"}],"identifier":"searching-for-notifications","label":"Searching for notifications","html_id":"searching-for-notifications","implicit":true,"key":"dW7DMe88QZ"},{"type":"paragraph","children":[{"type":"text","value":"Ssearching for notifications where available.","key":"gEuc4NQxur"}],"key":"fljkdSzrje"}],"key":"RCvH5Xr7NA"},{"type":"block","kind":"notebook-code","data":{"tags":[]},"children":[{"type":"code","lang":"python","executable":true,"value":"\n\nEND_DATE = datetime.now()\nSTART_DATE = END_DATE - timedelta(days=14)\n","visibility":"show","key":"VGWT47nAwJ"},{"type":"output","id":"gh3UPjmMF7OeCeA7HMIzj","data":[],"visibility":"show","key":"hK0PXYrZAS"}],"visibility":"show","key":"Y1rDJYHzAo"},{"type":"block","kind":"notebook-code","data":{"tags":[]},"children":[{"type":"code","lang":"python","executable":true,"value":"def triggered_function(notification):\n    \"\"\"\n    Function for the listener to trigger.\n    \"\"\"\n    \n    #pp(notification)\n    # Access the date field\n    date_str = notification['request']['date']    \n\n    # Convert the date string to a datetime object\n    date_obj = datetime.strptime(date_str, '%Y%m%d')\n    formatted_date = date_obj.strftime('%Y-%m-%d')\n    pp(\"ExtremeDT data available=>\" + formatted_date)\n    \n    ","visibility":"show","key":"j77Iu4FyI5"},{"type":"output","id":"raMkbkW1mMZ42UWE2OFZx","data":[],"visibility":"show","key":"ZYuOCIB7SC"}],"visibility":"show","key":"scQKBRkH2k"},{"type":"block","kind":"notebook-code","data":{"tags":[]},"children":[{"type":"code","lang":"python","executable":true,"value":"def create_hist_listener():\n    \"\"\"\n    Creates and returns a listener configuration.\n    \"\"\"\n\n    trigger = {\n        \"type\": TRIGGER_TYPE,\n        \"function\": triggered_function,\n    }  # Define the trigger for the listener\n    \n    # Return the complete listener configuration\n    return {\"event\": LISTENER_EVENT, \"request\": REQUEST, \"triggers\": [trigger]}\n","visibility":"show","key":"olbrQowhGy"},{"type":"output","id":"11Rm7lAbM0GI6lMEqqY9U","data":[],"visibility":"show","key":"t3s4zHnR0U"}],"visibility":"show","key":"brLPH4gJzh"},{"type":"block","kind":"notebook-code","data":{"tags":[]},"children":[{"type":"code","lang":"python","executable":true,"value":"try:\n    listener = create_hist_listener()  # Create listener configuration\n    listeners_config = {\"listeners\": [listener]}  # Define listeners configuration\n    config = user_config.UserConfig(**CONFIG)\n    print(\"loaded config:\")\n    pp(CONFIG)\n    nmh = NotificationManager()  # Initialize the NotificationManager\n\n    nmh.listen(\n        listeners=listeners_config, from_date=START_DATE,to_date=END_DATE, config=config\n    )  # Start listening\nexcept Exception as e:\n    print(f\"Failed to initialize the Notification Manager: {e}\")","visibility":"show","key":"ZHcUzehj90"},{"type":"output","id":"MtFn47T_QEhxipwHda6kx","data":[{"name":"stdout","output_type":"stream","text":"loaded config:\n{'auth_type': 'none',\n 'configuration_engine': {'host': 'aviso.lumi.apps.dte.destination-earth.eu',\n                          'https': True,\n                          'port': 443},\n 'notification_engine': {'host': 'aviso.lumi.apps.dte.destination-earth.eu',\n                         'https': True,\n                         'port': 443},\n 'quiet': True,\n 'remote_schema': True,\n 'schema_parser': 'generic'}\n'ExtremeDT data available=>2026-11-01'\n'ExtremeDT data available=>2026-10-29'\n'ExtremeDT data available=>2026-10-28'\n'ExtremeDT data available=>2026-10-27'\n'ExtremeDT data available=>2026-10-26'\n'ExtremeDT data available=>2026-10-25'\n'ExtremeDT da