r(pyaviso))\n","key":"dVZrP9fGyA"},{"type":"output","id":"pdQ_BWpNG5k5D_9dGDXee","data":[{"name":"stdout","output_type":"stream","text":"1.0.2\n['HOME_FOLDER', 'NotificationManager', 'Queue', 'SYSTEM_FOLDER', '__builtins__', '__cached__', '__doc__', '__file__', '__loader__', '__name__', '__package__', '__path__', '__spec__', '__version__', 'authentication', 'custom_exceptions', 'engine', 'event_listeners', 'exit_channel', 'logger', 'logging', 'notification_manager', 'triggers', 'user_config', 'version']\n"}],"key":"U7JjPQ6Tdl"}],"key":"iCS8Rzz7yb"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"children":[{"type":"text","value":"Import pyaviso","key":"C81Sh7cRVZ"}],"identifier":"import-pyaviso","label":"Import pyaviso","html_id":"import-pyaviso","implicit":true,"key":"FWVg86MNRv"},{"type":"paragraph","children":[{"type":"text","value":"Import pyaviso and other useful libraries. Defining constants and functions.","key":"msT83ReGkw"}],"key":"Wh2D29dmla"}],"key":"TD3cKtsZsr"},{"type":"block","kind":"notebook-code","data":{"tags":[]},"children":[{"type":"code","lang":"python","executable":true,"value":"import sys\n\nfrom datetime import datetime, timedelta\nfrom pprint import pprint as pp\n\nfrom pyaviso import NotificationManager, user_config","visibility":"show","key":"MMqYaVfLy5"},{"type":"output","id":"2v8ydUs6DYS8tv95S_oBL","data":[],"visibility":"show","key":"ajoVcxiQyl"}],"visibility":"show","key":"W8iHBSj2wg"},{"type":"block","kind":"notebook-code","data":{"tags":[]},"children":[{"type":"code","lang":"python","executable":true,"value":"LISTENER_EVENT = \"data\"  # Event for the listener, options are mars and dissemination\nTRIGGER_TYPE = \"function\"  # Type of trigger for the listener","visibility":"show","key":"R3i4thRs6K"},{"type":"output","id":"gTCAV2MDMJv1aPeDDDaDj","data":[],"visibility":"show","key":"MowDV3r7nw"}],"visibility":"show","key":"YyhhcwEZ9a"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"children":[{"type":"text","value":"Defining the data to be notified","key":"ptOmJY2V9q"}],"identifier":"defining-the-data-to-be-notified","label":"Defining the data to be notified","html_id":"defining-the-data-to-be-notified","implicit":true,"key":"Bk0lTZ3gcD"},{"type":"paragraph","children":[{"type":"text","value":"The following request describes the data whose availability we want to be notified","key":"IcChONWPLC"}],"key":"w2tBJ6iakc"}],"key":"LyzmMXP2Au"},{"type":"block","kind":"notebook-code","data":{"tags":[]},"children":[{"type":"code","lang":"python","executable":true,"value":"REQUEST = {\n    \"class\": \"d1\",\n    \"expver\": \"0001\",\n    \"stream\": \"wave\",\n    \"type\": \"fc\",\n    \"time\": \"00\",\n    \"step\": \"0\",\n    \"levtype\": \"sfc\",\n#    \"levelist\": \"\",\n#    \"param\": \"168\"   \n}  # Request configuration for the listener\n","visibility":"show","key":"p8yR5dwTXx"},{"type":"output","id":"JJ0fRP-UZjwjOqdXGarTg","data":[],"visibility":"show","key":"tqYbdPYPH4"}],"visibility":"show","key":"bnS6vhHtt2"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"children":[{"type":"text","value":"Aviso configuration","key":"DjdwB1lbUB"}],"identifier":"aviso-configuration","label":"Aviso configuration","html_id":"aviso-configuration","implicit":true,"key":"egHfOAa3g5"}],"key":"ldWQCBzng7"},{"type":"block","kind":"notebook-code","data":{"tags":[]},"children":[{"type":"code","lang":"python","executable":true,"value":"CONFIG = {\n    \"notification_engine\": {\n        \"host\": \"aviso.lumi.apps.dte.destination-earth.eu\",\n        \"port\": 443,\n        \"https\": True,\n    },\n    \"configuration_engine\": {\n        \"host\": \"aviso.lumi.apps.dte.destination-earth.eu\",\n        \"port\": 443,\n        \"https\": True,\n    },\n    \"schema_parser\": \"generic\",\n    \"remote_schema\": True,\n    \"auth_type\": \"none\",\n    \"quiet\" : True\n}  # manually defined configuration\n","visibility":"show","key":"tkZ0RRqTvZ"},{"type":"output","id":"UeTqks7dspPUi-SWEk_iV","data":[],"visibility":"show","key":"uGzAUHrFW7"}],"visibility":"show","key":"cGSf3Bzo6j"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"children":[{"type":"text","value":"Searching for notifications","key":"T5jy7QDLnu"}],"identifier":"searching-for-notifications","label":"Searching for notifications","html_id":"searching-for-notifications","implicit":true,"key":"XLEk5wZPnD"},{"type":"paragraph","children":[{"type":"text","value":"Ssearching for notifications where available.","key":"QfYQRmwrJz"}],"key":"EFKCbB2byu"}],"key":"BtJKrQ7QvR"},{"type":"block","kind":"notebook-code","data":{"tags":[]},"children":[{"type":"code","lang":"python","executable":true,"value":"\n\nEND_DATE = datetime.now()\nSTART_DATE = END_DATE - timedelta(days=14)\n","visibility":"show","key":"iXFdUq7Z34"},{"type":"output","id":"Rt-cETkzir_Ff30aSnmmd","data":[],"visibility":"show","key":"laKIuX72ti"}],"visibility":"show","key":"DuKyWB7sxX"},{"type":"block","kind":"notebook-code","data":{"tags":[]},"children":[{"type":"code","lang":"python","executable":true,"value":"def triggered_function(notification):\n    \"\"\"\n    Function for the listener to trigger.\n    \"\"\"\n    \n    #pp(notification)\n    # Access the date field\n    date_str = notification['request']['date']    \n\n    # Convert the date string to a datetime object\n    date_obj = datetime.strptime(date_str, '%Y%m%d')\n    formatted_date = date_obj.strftime('%Y-%m-%d')\n    pp(\"ExtremeDT data available=>\" + formatted_date)\n    \n    ","visibility":"show","key":"mJrB7seOKo"},{"type":"output","id":"TGGC2Cy0pCt6DdjSUVuls","data":[],"visibility":"show","key":"wmBZAsbOy3"}],"visibility":"show","key":"PQZ8dYBRC0"},{"type":"block","kind":"notebook-code","data":{"tags":[]},"children":[{"type":"code","lang":"python","executable":true,"value":"def create_hist_listener():\n    \"\"\"\n    Creates and returns a listener configuration.\n    \"\"\"\n\n    trigger = {\n        \"type\": TRIGGER_TYPE,\n        \"function\": triggered_function,\n    }  # Define the trigger for the listener\n    \n    # Return the complete listener configuration\n    return {\"event\": LISTENER_EVENT, \"request\": REQUEST, \"triggers\": [trigger]}\n","visibility":"show","key":"mUMkr1eHy6"},{"type":"output","id":"1iEpZo6UrtmgwTHhbSW83","data":[],"visibility":"show","key":"NRBCmeGaY4"}],"visibility":"show","key":"IV4bFSCUxF"},{"type":"block","kind":"notebook-code","data":{"tags":[]},"children":[{"type":"code","lang":"python","executable":true,"value":"try:\n    listener = create_hist_listener()  # Create listener configuration\n    listeners_config = {\"listeners\": [listener]}  # Define listeners configuration\n    config = user_config.UserConfig(**CONFIG)\n    print(\"loaded config:\")\n    pp(CONFIG)\n    nmh = NotificationManager()  # Initialize the NotificationManager\n\n    nmh.listen(\n        listeners=listeners_config, from_date=START_DATE,to_date=END_DATE, config=config\n    )  # Start listening\nexcept Exception as e:\n    print(f\"Failed to initialize the Notification Manager: {e}\")","visibility":"show","key":"ZSjYwIdRJ6"},{"type":"output","id":"EcMzLgHUh6pnVuoFH0wjV","data":[{"name":"stdout","output_type":"stream","text":"loaded config:\n{'auth_type': 'none',\n 'configuration_engine': {'host': 'aviso.lumi.apps.dte.destination-earth.eu',\n                          'https': True,\n                          'port': 443},\n 'notification_engine': {'host': 'aviso.lumi.apps.dte.destination-earth.eu',\n                         'https': True,\n                         'port': 443},\n 'quiet': True,\n 'remote_schema': True,\n 'schema_parser': 'generic'}\n'ExtremeDT data available=>2026-07-27'\n'ExtremeDT data available=>2026-07-26'\n'ExtremeDT data available=>2026-07-25'\n'ExtremeDT data available=>2026-07-24'\n'ExtremeDT data available=>2026-07-23'\n'ExtremeDT data available=>2026-07-22'\n'ExtremeDT da