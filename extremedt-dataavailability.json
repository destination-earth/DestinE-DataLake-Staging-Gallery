ing","depth":2,"children":[{"type":"text","value":"Defining the data to be notified","key":"ogur7Q0yoU"}],"identifier":"defining-the-data-to-be-notified","label":"Defining the data to be notified","html_id":"defining-the-data-to-be-notified","implicit":true,"key":"GLCOxJ6D3b"},{"type":"paragraph","children":[{"type":"text","value":"The following request describes the data whose availability we want to be notified","key":"hGkzyHP6w6"}],"key":"wJJTOuPw6z"}],"key":"T0u7GYjshY"},{"type":"block","kind":"notebook-code","data":{"tags":[]},"children":[{"type":"code","lang":"python","executable":true,"value":"REQUEST = {\n    \"class\": \"d1\",\n    \"expver\": \"0001\",\n    \"stream\": \"wave\",\n    \"type\": \"fc\",\n    \"time\": \"00\",\n    \"step\": \"0\",\n    \"levtype\": \"sfc\",\n#    \"levelist\": \"\",\n#    \"param\": \"168\"   \n}  # Request configuration for the listener\n","visibility":"show","key":"yvXp1x1M7n"},{"type":"output","id":"VWY-4SHVjsW6cxZWtPTmh","data":[],"visibility":"show","key":"SaD3soIvRH"}],"visibility":"show","key":"Qnqiqkpofx"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"children":[{"type":"text","value":"Aviso configuration","key":"WlN7fQcTkB"}],"identifier":"aviso-configuration","label":"Aviso configuration","html_id":"aviso-configuration","implicit":true,"key":"ZwiaKg3aFk"}],"key":"Sz9vuGPxhu"},{"type":"block","kind":"notebook-code","data":{"tags":[]},"children":[{"type":"code","lang":"python","executable":true,"value":"CONFIG = {\n    \"notification_engine\": {\n        \"host\": \"aviso.lumi.apps.dte.destination-earth.eu\",\n        \"port\": 443,\n        \"https\": True,\n    },\n    \"configuration_engine\": {\n        \"host\": \"aviso.lumi.apps.dte.destination-earth.eu\",\n        \"port\": 443,\n        \"https\": True,\n    },\n    \"schema_parser\": \"generic\",\n    \"remote_schema\": True,\n    \"auth_type\": \"none\",\n    \"quiet\" : True\n}  # manually defined configuration\n","visibility":"show","key":"kFRo2vofIM"},{"type":"output","id":"5wULvna0Bcn70NmjPqHaD","data":[],"visibility":"show","key":"G1W51dA36x"}],"visibility":"show","key":"DxnThZG8Ji"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"children":[{"type":"text","value":"Searching for notifications","key":"gr1jtQTmC0"}],"identifier":"searching-for-notifications","label":"Searching for notifications","html_id":"searching-for-notifications","implicit":true,"key":"CsQaOwqPPr"},{"type":"paragraph","children":[{"type":"text","value":"Ssearching for notifications where available.","key":"IN2onY3bFQ"}],"key":"qh7Iqote0s"}],"key":"HULK0f3pCF"},{"type":"block","kind":"notebook-code","data":{"tags":[]},"children":[{"type":"code","lang":"python","executable":true,"value":"\n\nEND_DATE = datetime.now()\nSTART_DATE = END_DATE - timedelta(days=14)\n","visibility":"show","key":"UBValFIkwF"},{"type":"output","id":"-aAw8ifKUXc1exD-aSH7T","data":[],"visibility":"show","key":"Wx0mgZzdby"}],"visibility":"show","key":"yXSAnCTkG2"},{"type":"block","kind":"notebook-code","data":{"tags":[]},"children":[{"type":"code","lang":"python","executable":true,"value":"def triggered_function(notification):\n    \"\"\"\n    Function for the listener to trigger.\n    \"\"\"\n    \n    #pp(notification)\n    # Access the date field\n    date_str = notification['request']['date']    \n\n    # Convert the date string to a datetime object\n    date_obj = datetime.strptime(date_str, '%Y%m%d')\n    formatted_date = date_obj.strftime('%Y-%m-%d')\n    pp(\"ExtremeDT data available=>\" + formatted_date)\n    \n    ","visibility":"show","key":"ZA9GTPGvo6"},{"type":"output","id":"D7Uzk-2jlvU8wwAUElbaj","data":[],"visibility":"show","key":"hnyTbLsmxK"}],"visibility":"show","key":"uh6oT9zZ3K"},{"type":"block","kind":"notebook-code","data":{"tags":[]},"children":[{"type":"code","lang":"python","executable":true,"value":"def create_hist_listener():\n    \"\"\"\n    Creates and returns a listener configuration.\n    \"\"\"\n\n    trigger = {\n        \"type\": TRIGGER_TYPE,\n        \"function\": triggered_function,\n    }  # Define the trigger for the listener\n    \n    # Return the complete listener configuration\n    return {\"event\": LISTENER_EVENT, \"request\": REQUEST, \"triggers\": [trigger]}\n","visibility":"show","key":"gCFowdc8w5"},{"type":"output","id":"Pd8_ZJiHvsGatMOEscRgU","data":[],"visibility":"show","key":"z5P9wgxYNx"}],"visibility":"show","key":"Vjop3KKHdD"},{"type":"block","kind":"notebook-code","data":{"tags":[]},"children":[{"type":"code","lang":"python","executable":true,"value":"try:\n    listener = create_hist_listener()  # Create listener configuration\n    listeners_config = {\"listeners\": [listener]}  # Define listeners configuration\n    config = user_config.UserConfig(**CONFIG)\n    print(\"loaded config:\")\n    pp(CONFIG)\n    nmh = NotificationManager()  # Initialize the NotificationManager\n\n    nmh.listen(\n        listeners=listeners_config, from_date=START_DATE,to_date=END_DATE, config=config\n    )  # Start listening\nexcept Exception as e:\n    print(f\"Failed to initialize the Notification Manager: {e}\")","visibility":"show","key":"B6I2lR85Gv"},{"type":"output","id":"OzVTeL24XgM5rIwPhpYyA","data":[{"name":"stdout","output_type":"stream","text":"loaded config:\n{'auth_type': 'none',\n 'configuration_engine': {'host': 'aviso.lumi.apps.dte.destination-earth.eu',\n                          'https': True,\n                          'port': 443},\n 'notification_engine': {'host': 'aviso.lumi.apps.dte.destination-earth.eu',\n                         'https': True,\n                         'port': 443},\n 'quiet': True,\n 'remote_schema': True,\n 'schema_parser': 'generic'}\n'ExtremeDT data available=>2026-07-27'\n'ExtremeDT data available=>2026-07-26'\n'ExtremeDT data available=>2026-07-25'\n'ExtremeDT data available=>2026-07-24'\n'ExtremeDT data available=>2026-07-23'\n'ExtremeDT data available=>2026-07-22'\n'ExtremeDT da