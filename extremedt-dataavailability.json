ing","depth":2,"children":[{"type":"text","value":"Defining the data to be notified","key":"fwVW5wKPQl"}],"identifier":"defining-the-data-to-be-notified","label":"Defining the data to be notified","html_id":"defining-the-data-to-be-notified","implicit":true,"key":"w7BwKkbvjU"},{"type":"paragraph","children":[{"type":"text","value":"The following request describes the data whose availability we want to be notified","key":"o6YrDwY6Rm"}],"key":"rLuFRDe47P"}],"key":"hyMA12ONV2"},{"type":"block","kind":"notebook-code","data":{"tags":[]},"children":[{"type":"code","lang":"python","executable":true,"value":"REQUEST = {\n    \"class\": \"d1\",\n    \"expver\": \"0001\",\n    \"stream\": \"wave\",\n    \"type\": \"fc\",\n    \"time\": \"00\",\n    \"step\": \"0\",\n    \"levtype\": \"sfc\",\n#    \"levelist\": \"\",\n#    \"param\": \"168\"   \n}  # Request configuration for the listener\n","visibility":"show","key":"OIkiNPGwUn"},{"type":"output","id":"QmDA9r4KQbQR0GvGXCOza","data":[],"visibility":"show","key":"IvM0a962kc"}],"visibility":"show","key":"nSWWPRaiJA"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"children":[{"type":"text","value":"Aviso configuration","key":"F32RM7HZUc"}],"identifier":"aviso-configuration","label":"Aviso configuration","html_id":"aviso-configuration","implicit":true,"key":"WbfzWanx2P"}],"key":"yqF9XWXYuH"},{"type":"block","kind":"notebook-code","data":{"tags":[]},"children":[{"type":"code","lang":"python","executable":true,"value":"CONFIG = {\n    \"notification_engine\": {\n        \"host\": \"aviso.lumi.apps.dte.destination-earth.eu\",\n        \"port\": 443,\n        \"https\": True,\n    },\n    \"configuration_engine\": {\n        \"host\": \"aviso.lumi.apps.dte.destination-earth.eu\",\n        \"port\": 443,\n        \"https\": True,\n    },\n    \"schema_parser\": \"generic\",\n    \"remote_schema\": True,\n    \"auth_type\": \"none\",\n    \"quiet\" : True\n}  # manually defined configuration\n","visibility":"show","key":"mX0hswNZ4k"},{"type":"output","id":"352DOEWyB7z8d1qoo73DH","data":[],"visibility":"show","key":"pJRrmt7IYx"}],"visibility":"show","key":"lMHvAzivfv"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"children":[{"type":"text","value":"Searching for notifications","key":"bWF7lH8SZT"}],"identifier":"searching-for-notifications","label":"Searching for notifications","html_id":"searching-for-notifications","implicit":true,"key":"TkI3mcAKOa"},{"type":"paragraph","children":[{"type":"text","value":"Ssearching for notifications where available.","key":"vfm6bANhaO"}],"key":"hQztn8AG6B"}],"key":"BgBrBnFQQ6"},{"type":"block","kind":"notebook-code","data":{"tags":[]},"children":[{"type":"code","lang":"python","executable":true,"value":"\n\nEND_DATE = datetime.now()\nSTART_DATE = END_DATE - timedelta(days=14)\n","visibility":"show","key":"CdJtrPifQS"},{"type":"output","id":"ZsGEYzNNYOOmHDJ9x3962","data":[],"visibility":"show","key":"R8RCC8oktQ"}],"visibility":"show","key":"qVgHQU5wYI"},{"type":"block","kind":"notebook-code","data":{"tags":[]},"children":[{"type":"code","lang":"python","executable":true,"value":"def triggered_function(notification):\n    \"\"\"\n    Function for the listener to trigger.\n    \"\"\"\n    \n    #pp(notification)\n    # Access the date field\n    date_str = notification['request']['date']    \n\n    # Convert the date string to a datetime object\n    date_obj = datetime.strptime(date_str, '%Y%m%d')\n    formatted_date = date_obj.strftime('%Y-%m-%d')\n    pp(\"ExtremeDT data available=>\" + formatted_date)\n    \n    ","visibility":"show","key":"bqBaUYJuaf"},{"type":"output","id":"pITP1oi8LejjVPaotYM18","data":[],"visibility":"show","key":"vNKZfEqtMn"}],"visibility":"show","key":"BuFWfP1h8U"},{"type":"block","kind":"notebook-code","data":{"tags":[]},"children":[{"type":"code","lang":"python","executable":true,"value":"def create_hist_listener():\n    \"\"\"\n    Creates and returns a listener configuration.\n    \"\"\"\n\n    trigger = {\n        \"type\": TRIGGER_TYPE,\n        \"function\": triggered_function,\n    }  # Define the trigger for the listener\n    \n    # Return the complete listener configuration\n    return {\"event\": LISTENER_EVENT, \"request\": REQUEST, \"triggers\": [trigger]}\n","visibility":"show","key":"iOdXdiAl6X"},{"type":"output","id":"o6N1zL81q5gKPyl8Qg2bF","data":[],"visibility":"show","key":"yamcHt8loH"}],"visibility":"show","key":"Wie2dy3z1T"},{"type":"block","kind":"notebook-code","data":{"tags":[]},"children":[{"type":"code","lang":"python","executable":true,"value":"try:\n    listener = create_hist_listener()  # Create listener configuration\n    listeners_config = {\"listeners\": [listener]}  # Define listeners configuration\n    config = user_config.UserConfig(**CONFIG)\n    print(\"loaded config:\")\n    pp(CONFIG)\n    nmh = NotificationManager()  # Initialize the NotificationManager\n\n    nmh.listen(\n        listeners=listeners_config, from_date=START_DATE,to_date=END_DATE, config=config\n    )  # Start listening\nexcept Exception as e:\n    print(f\"Failed to initialize the Notification Manager: {e}\")","visibility":"show","key":"CcRb9poNSS"},{"type":"output","id":"1T-KSk6_-jmHRxd2RpivF","data":[{"name":"stdout","output_type":"stream","text":"loaded config:\n{'auth_type': 'none',\n 'configuration_engine': {'host': 'aviso.lumi.apps.dte.destination-earth.eu',\n                          'https': True,\n                          'port': 443},\n 'notification_engine': {'host': 'aviso.lumi.apps.dte.destination-earth.eu',\n                         'https': True,\n                         'port': 443},\n 'quiet': True,\n 'remote_schema': True,\n 'schema_parser': 'generic'}\n'ExtremeDT data available=>2026-11-01'\n'ExtremeDT data available=>2026-10-29'\n'ExtremeDT data available=>2026-10-28'\n'ExtremeDT data available=>2026-10-27'\n'ExtremeDT data available=>2026-10-26'\n'ExtremeDT data available=>2026-10-25'\n'ExtremeDT data available=>2026-10-24'\n'ExtremeDT data available=>2026-10-23'\n"}],"visibility":"show","key":"Wu3XLLVDYs"}],"visibility":"show","key":"X8fhKiIJeo"}],"key":"buYu0fgqta"},"references":{"cite":{"order":[],"data":{}}},"footer":{},"domain":"http://localhost:3000"}