ing","depth":2,"children":[{"type":"text","value":"Defining the data to be notified","key":"tzAtqPYADS"}],"identifier":"defining-the-data-to-be-notified","label":"Defining the data to be notified","html_id":"defining-the-data-to-be-notified","implicit":true,"key":"Jeg3G8wXCU"},{"type":"paragraph","children":[{"type":"text","value":"The following request describes the data whose availability we want to be notified","key":"PMxQpX1aHf"}],"key":"U05lBizpWI"}],"key":"lOlJOip3XZ"},{"type":"block","kind":"notebook-code","data":{"tags":[]},"children":[{"type":"code","lang":"python","executable":true,"value":"REQUEST = {\n    \"class\": \"d1\",\n    \"expver\": \"0001\",\n    \"stream\": \"wave\",\n    \"type\": \"fc\",\n    \"time\": \"00\",\n    \"step\": \"0\",\n    \"levtype\": \"sfc\",\n#    \"levelist\": \"\",\n#    \"param\": \"168\"   \n}  # Request configuration for the listener\n","visibility":"show","key":"JE8hlPPZZy"},{"type":"output","id":"41XEW5KEaiZGfQKndJPQj","data":[],"visibility":"show","key":"RNC9G3PYIb"}],"visibility":"show","key":"GP8vByNp0W"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"children":[{"type":"text","value":"Aviso configuration","key":"j6WWsqYQcg"}],"identifier":"aviso-configuration","label":"Aviso configuration","html_id":"aviso-configuration","implicit":true,"key":"FWtWXUKgFN"}],"key":"SUd10pi4Wi"},{"type":"block","kind":"notebook-code","data":{"tags":[]},"children":[{"type":"code","lang":"python","executable":true,"value":"CONFIG = {\n    \"notification_engine\": {\n        \"host\": \"aviso.lumi.apps.dte.destination-earth.eu\",\n        \"port\": 443,\n        \"https\": True,\n    },\n    \"configuration_engine\": {\n        \"host\": \"aviso.lumi.apps.dte.destination-earth.eu\",\n        \"port\": 443,\n        \"https\": True,\n    },\n    \"schema_parser\": \"generic\",\n    \"remote_schema\": True,\n    \"auth_type\": \"none\",\n    \"quiet\" : True\n}  # manually defined configuration\n","visibility":"show","key":"jfxVP4fyr9"},{"type":"output","id":"g9bZyui-wsPbjZvPh-Rmx","data":[],"visibility":"show","key":"P4JBenLCFE"}],"visibility":"show","key":"IQCNlHS8wm"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"children":[{"type":"text","value":"Searching for notifications","key":"x7TQWY3kls"}],"identifier":"searching-for-notifications","label":"Searching for notifications","html_id":"searching-for-notifications","implicit":true,"key":"SxXCfduPHI"},{"type":"paragraph","children":[{"type":"text","value":"Ssearching for notifications where available.","key":"OXMGYEIaFH"}],"key":"lNhvgbEDZc"}],"key":"iYD3FMHlgy"},{"type":"block","kind":"notebook-code","data":{"tags":[]},"children":[{"type":"code","lang":"python","executable":true,"value":"\n\nEND_DATE = datetime.now()\nSTART_DATE = END_DATE - timedelta(days=14)\n","visibility":"show","key":"E1sAYZrMQh"},{"type":"output","id":"TU8RKkgI4gU8rmPD3JK98","data":[],"visibility":"show","key":"EZC4GE9oEd"}],"visibility":"show","key":"Xu8b39zqUv"},{"type":"block","kind":"notebook-code","data":{"tags":[]},"children":[{"type":"code","lang":"python","executable":true,"value":"def triggered_function(notification):\n    \"\"\"\n    Function for the listener to trigger.\n    \"\"\"\n    \n    #pp(notification)\n    # Access the date field\n    date_str = notification['request']['date']    \n\n    # Convert the date string to a datetime object\n    date_obj = datetime.strptime(date_str, '%Y%m%d')\n    formatted_date = date_obj.strftime('%Y-%m-%d')\n    pp(\"ExtremeDT data available=>\" + formatted_date)\n    \n    ","visibility":"show","key":"VA5KArZLu2"},{"type":"output","id":"au1wwHqL7QkfmO0uF6uTU","data":[],"visibility":"show","key":"osAdX8njY3"}],"visibility":"show","key":"K7X16jJE1W"},{"type":"block","kind":"notebook-code","data":{"tags":[]},"children":[{"type":"code","lang":"python","executable":true,"value":"def create_hist_listener():\n    \"\"\"\n    Creates and returns a listener configuration.\n    \"\"\"\n\n    trigger = {\n        \"type\": TRIGGER_TYPE,\n        \"function\": triggered_function,\n    }  # Define the trigger for the listener\n    \n    # Return the complete listener configuration\n    return {\"event\": LISTENER_EVENT, \"request\": REQUEST, \"triggers\": [trigger]}\n","visibility":"show","key":"BDkqgGxKQd"},{"type":"output","id":"H5BlmnCN4qeYaGU-5j1gG","data":[],"visibility":"show","key":"Axxnm0aXUo"}],"visibility":"show","key":"ADeVFkDKCh"},{"type":"block","kind":"notebook-code","data":{"tags":[]},"children":[{"type":"code","lang":"python","executable":true,"value":"try:\n    listener = create_hist_listener()  # Create listener configuration\n    listeners_config = {\"listeners\": [listener]}  # Define listeners configuration\n    config = user_config.UserConfig(**CONFIG)\n    print(\"loaded config:\")\n    pp(CONFIG)\n    nmh = NotificationManager()  # Initialize the NotificationManager\n\n    nmh.listen(\n        listeners=listeners_config, from_date=START_DATE,to_date=END_DATE, config=config\n    )  # Start listening\nexcept Exception as e:\n    print(f\"Failed to initialize the Notification Manager: {e}\")","visibility":"show","key":"gfRlyBG634"},{"type":"output","id":"pZdSQiQ34XCqngayT5dxE","data":[{"name":"stdout","output_type":"stream","text":"loaded config:\n{'auth_type': 'none',\n 'configuration_engine': {'host': 'aviso.lumi.apps.dte.destination-earth.eu',\n                          'https': True,\n                          'port': 443},\n 'notification_engine': {'host': 'aviso.lumi.apps.dte.destination-earth.eu',\n                         'https': True,\n                         'port': 443},\n 'quiet': True,\n 'remote_schema': True,\n 'schema_parser': 'generic'}\n'ExtremeDT data available=>2026-07-27'\n'ExtremeDT data available=>2026-07-26'\n'ExtremeDT data available=>2026-07-25'\n'ExtremeDT data available=>2026-07-24'\n'ExtremeDT data available=>2026-07-23'\n'ExtremeDT data available=>2026-07-22'\n'ExtremeDT da