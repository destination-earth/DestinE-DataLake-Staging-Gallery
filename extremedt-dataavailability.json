ing","depth":2,"children":[{"type":"text","value":"Defining the data to be notified","key":"xRMY3lpf6R"}],"identifier":"defining-the-data-to-be-notified","label":"Defining the data to be notified","html_id":"defining-the-data-to-be-notified","implicit":true,"key":"YNhuBpbjfp"},{"type":"paragraph","children":[{"type":"text","value":"The following request describes the data whose availability we want to be notified","key":"i7C56BYoDR"}],"key":"L1L6dkLL42"}],"key":"cvPojQBU5y"},{"type":"block","kind":"notebook-code","data":{"tags":[]},"children":[{"type":"code","lang":"python","executable":true,"value":"REQUEST = {\n    \"class\": \"d1\",\n    \"expver\": \"0001\",\n    \"stream\": \"wave\",\n    \"type\": \"fc\",\n    \"time\": \"00\",\n    \"step\": \"0\",\n    \"levtype\": \"sfc\",\n#    \"levelist\": \"\",\n#    \"param\": \"168\"   \n}  # Request configuration for the listener\n","visibility":"show","key":"RhwnQ2fpef"},{"type":"output","id":"EOfDMZCdw-E-t1olb94eE","data":[],"visibility":"show","key":"NG3gH03FFW"}],"visibility":"show","key":"auanFoxKsQ"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"children":[{"type":"text","value":"Aviso configuration","key":"GDLjBVYQF1"}],"identifier":"aviso-configuration","label":"Aviso configuration","html_id":"aviso-configuration","implicit":true,"key":"U4Kphzh2ms"}],"key":"C9Nad7v6t0"},{"type":"block","kind":"notebook-code","data":{"tags":[]},"children":[{"type":"code","lang":"python","executable":true,"value":"CONFIG = {\n    \"notification_engine\": {\n        \"host\": \"aviso.lumi.apps.dte.destination-earth.eu\",\n        \"port\": 443,\n        \"https\": True,\n    },\n    \"configuration_engine\": {\n        \"host\": \"aviso.lumi.apps.dte.destination-earth.eu\",\n        \"port\": 443,\n        \"https\": True,\n    },\n    \"schema_parser\": \"generic\",\n    \"remote_schema\": True,\n    \"auth_type\": \"none\",\n    \"quiet\" : True\n}  # manually defined configuration\n","visibility":"show","key":"cMxXwdqj5w"},{"type":"output","id":"BKYbDcg2MAwp_UYxuLiWg","data":[],"visibility":"show","key":"PoeD5IaaqU"}],"visibility":"show","key":"Mt7spIDRxA"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"children":[{"type":"text","value":"Searching for notifications","key":"fpzPULvrFb"}],"identifier":"searching-for-notifications","label":"Searching for notifications","html_id":"searching-for-notifications","implicit":true,"key":"bH4ive41xK"},{"type":"paragraph","children":[{"type":"text","value":"Ssearching for notifications where available.","key":"EeTral0v3O"}],"key":"y4ps0g5NpL"}],"key":"FtGg4hpAPX"},{"type":"block","kind":"notebook-code","data":{"tags":[]},"children":[{"type":"code","lang":"python","executable":true,"value":"\n\nEND_DATE = datetime.now()\nSTART_DATE = END_DATE - timedelta(days=14)\n","visibility":"show","key":"mnHZRRA9NZ"},{"type":"output","id":"IdgGfo96dsvOWrV1mj7yE","data":[],"visibility":"show","key":"QtMPiDmNqJ"}],"visibility":"show","key":"d7mHkPTFZc"},{"type":"block","kind":"notebook-code","data":{"tags":[]},"children":[{"type":"code","lang":"python","executable":true,"value":"def triggered_function(notification):\n    \"\"\"\n    Function for the listener to trigger.\n    \"\"\"\n    \n    #pp(notification)\n    # Access the date field\n    date_str = notification['request']['date']    \n\n    # Convert the date string to a datetime object\n    date_obj = datetime.strptime(date_str, '%Y%m%d')\n    formatted_date = date_obj.strftime('%Y-%m-%d')\n    pp(\"ExtremeDT data available=>\" + formatted_date)\n    \n    ","visibility":"show","key":"q2o8FGAw2L"},{"type":"output","id":"8YTxfm5OgWWUc-G16uWyd","data":[],"visibility":"show","key":"OfI8jwmwUf"}],"visibility":"show","key":"KQMy9ImNbR"},{"type":"block","kind":"notebook-code","data":{"tags":[]},"children":[{"type":"code","lang":"python","executable":true,"value":"def create_hist_listener():\n    \"\"\"\n    Creates and returns a listener configuration.\n    \"\"\"\n\n    trigger = {\n        \"type\": TRIGGER_TYPE,\n        \"function\": triggered_function,\n    }  # Define the trigger for the listener\n    \n    # Return the complete listener configuration\n    return {\"event\": LISTENER_EVENT, \"request\": REQUEST, \"triggers\": [trigger]}\n","visibility":"show","key":"hxo5PesLfW"},{"type":"output","id":"tChbOs-ucK-bIY5hFFixz","data":[],"visibility":"show","key":"Dfp8j424Ri"}],"visibility":"show","key":"LbpbtK8cmq"},{"type":"block","kind":"notebook-code","data":{"tags":[]},"children":[{"type":"code","lang":"python","executable":true,"value":"try:\n    listener = create_hist_listener()  # Create listener configuration\n    listeners_config = {\"listeners\": [listener]}  # Define listeners configuration\n    config = user_config.UserConfig(**CONFIG)\n    print(\"loaded config:\")\n    pp(CONFIG)\n    nmh = NotificationManager()  # Initialize the NotificationManager\n\n    nmh.listen(\n        listeners=listeners_config, from_date=START_DATE,to_date=END_DATE, config=config\n    )  # Start listening\nexcept Exception as e:\n    print(f\"Failed to initialize the Notification Manager: {e}\")","visibility":"show","key":"ECMyGpJfkl"},{"type":"output","id":"l2Lx-KT1GIZrjpWN4xN6q","data":[{"name":"stdout","output_type":"stream","text":"loaded config:\n{'auth_type': 'none',\n 'configuration_engine': {'host': 'aviso.lumi.apps.dte.destination-earth.eu',\n                          'https': True,\n                          'port': 443},\n 'notification_engine': {'host': 'aviso.lumi.apps.dte.destination-earth.eu',\n                         'https': True,\n                         'port': 443},\n 'quiet': True,\n 'remote_schema': True,\n 'schema_parser': 'generic'}\n'ExtremeDT data available=>2026-11-01'\n'ExtremeDT data available=>2026-10-29'\n'ExtremeDT data available=>2026-10-28'\n'ExtremeDT data available=>2026-10-27'\n'ExtremeDT data available=>2026-10-26'\n'ExtremeDT data available=>2026-10-25'\n'ExtremeDT data available=>2026-10-24'\n'ExtremeDT data available=>2026-10-23'\n"}],"visibility":"show","key":"XvjgOtYELD"}],"visibility":"show","key":"sOqKNAcccG"}],"key":"XjDY3L1Km2"},"references":{"cite":{"order":[],"data":{}}},"footer":{},"domain":"http://localhost:3000"}