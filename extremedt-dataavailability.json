ing","depth":2,"children":[{"type":"text","value":"Defining the data to be notified","key":"HBtzbwMTSl"}],"identifier":"defining-the-data-to-be-notified","label":"Defining the data to be notified","html_id":"defining-the-data-to-be-notified","implicit":true,"key":"wkoLjzBSXT"},{"type":"paragraph","children":[{"type":"text","value":"The following request describes the data whose availability we want to be notified","key":"rIQ6e1T6U2"}],"key":"CXIspb6CU3"}],"key":"NmhRCPQ7kD"},{"type":"block","kind":"notebook-code","data":{"tags":[]},"children":[{"type":"code","lang":"python","executable":true,"value":"REQUEST = {\n    \"class\": \"d1\",\n    \"expver\": \"0001\",\n    \"stream\": \"wave\",\n    \"type\": \"fc\",\n    \"time\": \"00\",\n    \"step\": \"0\",\n    \"levtype\": \"sfc\",\n#    \"levelist\": \"\",\n#    \"param\": \"168\"   \n}  # Request configuration for the listener\n","visibility":"show","key":"Zp1JUac5kh"},{"type":"output","id":"pIluHwCUDK6UYZTGtctPv","data":[],"visibility":"show","key":"GdlTUsdNu7"}],"visibility":"show","key":"T2oyMLcAE5"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"children":[{"type":"text","value":"Aviso configuration","key":"aqqQVkMpbY"}],"identifier":"aviso-configuration","label":"Aviso configuration","html_id":"aviso-configuration","implicit":true,"key":"FIQJDvz0Ej"}],"key":"Y7k5nUAqfx"},{"type":"block","kind":"notebook-code","data":{"tags":[]},"children":[{"type":"code","lang":"python","executable":true,"value":"CONFIG = {\n    \"notification_engine\": {\n        \"host\": \"aviso.lumi.apps.dte.destination-earth.eu\",\n        \"port\": 443,\n        \"https\": True,\n    },\n    \"configuration_engine\": {\n        \"host\": \"aviso.lumi.apps.dte.destination-earth.eu\",\n        \"port\": 443,\n        \"https\": True,\n    },\n    \"schema_parser\": \"generic\",\n    \"remote_schema\": True,\n    \"auth_type\": \"none\",\n    \"quiet\" : True\n}  # manually defined configuration\n","visibility":"show","key":"S94mqUgkw1"},{"type":"output","id":"0RaL_2Wtzj-P2jq7mcAPu","data":[],"visibility":"show","key":"OhS4Ns7AsP"}],"visibility":"show","key":"tzfZhQZJOu"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"children":[{"type":"text","value":"Searching for notifications","key":"gh3unwDXtB"}],"identifier":"searching-for-notifications","label":"Searching for notifications","html_id":"searching-for-notifications","implicit":true,"key":"S3pyTSwYqx"},{"type":"paragraph","children":[{"type":"text","value":"Ssearching for notifications where available.","key":"FswOEOSZPZ"}],"key":"E71Y8a1DwX"}],"key":"hyIZtkRyKz"},{"type":"block","kind":"notebook-code","data":{"tags":[]},"children":[{"type":"code","lang":"python","executable":true,"value":"\n\nEND_DATE = datetime.now()\nSTART_DATE = END_DATE - timedelta(days=14)\n","visibility":"show","key":"D1EceOj7a4"},{"type":"output","id":"-TC2cn_i8DvVDkVDFe2Vd","data":[],"visibility":"show","key":"rhg1EFm9zW"}],"visibility":"show","key":"AtMcpaGJpY"},{"type":"block","kind":"notebook-code","data":{"tags":[]},"children":[{"type":"code","lang":"python","executable":true,"value":"def triggered_function(notification):\n    \"\"\"\n    Function for the listener to trigger.\n    \"\"\"\n    \n    #pp(notification)\n    # Access the date field\n    date_str = notification['request']['date']    \n\n    # Convert the date string to a datetime object\n    date_obj = datetime.strptime(date_str, '%Y%m%d')\n    formatted_date = date_obj.strftime('%Y-%m-%d')\n    pp(\"ExtremeDT data available=>\" + formatted_date)\n    \n    ","visibility":"show","key":"tgqbmvYeBV"},{"type":"output","id":"C05zVwYmOgaYMc-Zdk1lx","data":[],"visibility":"show","key":"tdakw82PV8"}],"visibility":"show","key":"BdSorGGpp2"},{"type":"block","kind":"notebook-code","data":{"tags":[]},"children":[{"type":"code","lang":"python","executable":true,"value":"def create_hist_listener():\n    \"\"\"\n    Creates and returns a listener configuration.\n    \"\"\"\n\n    trigger = {\n        \"type\": TRIGGER_TYPE,\n        \"function\": triggered_function,\n    }  # Define the trigger for the listener\n    \n    # Return the complete listener configuration\n    return {\"event\": LISTENER_EVENT, \"request\": REQUEST, \"triggers\": [trigger]}\n","visibility":"show","key":"Ei3x2mFu4z"},{"type":"output","id":"zM8Zqn6Fj5czzc7ruNwoL","data":[],"visibility":"show","key":"io6utPvAf9"}],"visibility":"show","key":"rBZ9afIpwa"},{"type":"block","kind":"notebook-code","data":{"tags":[]},"children":[{"type":"code","lang":"python","executable":true,"value":"try:\n    listener = create_hist_listener()  # Create listener configuration\n    listeners_config = {\"listeners\": [listener]}  # Define listeners configuration\n    config = user_config.UserConfig(**CONFIG)\n    print(\"loaded config:\")\n    pp(CONFIG)\n    nmh = NotificationManager()  # Initialize the NotificationManager\n\n    nmh.listen(\n        listeners=listeners_config, from_date=START_DATE,to_date=END_DATE, config=config\n    )  # Start listening\nexcept Exception as e:\n    print(f\"Failed to initialize the Notification Manager: {e}\")","visibility":"show","key":"MGIOD8JN5J"},{"type":"output","id":"rtN79DAhhiuf_Zw-QXjyP","data":[{"name":"stdout","output_type":"stream","text":"loaded config:\n{'auth_type': 'none',\n 'configuration_engine': {'host': 'aviso.lumi.apps.dte.destination-earth.eu',\n                          'https': True,\n                          'port': 443},\n 'notification_engine': {'host': 'aviso.lumi.apps.dte.destination-earth.eu',\n                         'https': True,\n                         'port': 443},\n 'quiet': True,\n 'remote_schema': True,\n 'schema_parser': 'generic'}\n'ExtremeDT data available=>2026-07-17'\n'ExtremeDT data available=>2026-07-16'\n'ExtremeDT data available=>2026-07-15'\n'ExtremeDT data available=>2026-07-14'\n'ExtremeDT data available=>2026-07-13'\n'ExtremeDT data available=>2026-07-12'\n'ExtremeDT da