ing","depth":2,"children":[{"type":"text","value":"Defining the data to be notified","key":"YvJufwkmO3"}],"identifier":"defining-the-data-to-be-notified","label":"Defining the data to be notified","html_id":"defining-the-data-to-be-notified","implicit":true,"key":"C3n8NMPI82"},{"type":"paragraph","children":[{"type":"text","value":"The following request describes the data whose availability we want to be notified","key":"QzdTZ0u4VW"}],"key":"zEuYRhSSd9"}],"key":"xRcqGdbVUV"},{"type":"block","kind":"notebook-code","data":{"tags":[]},"children":[{"type":"code","lang":"python","executable":true,"value":"REQUEST = {\n    \"class\": \"d1\",\n    \"expver\": \"0001\",\n    \"stream\": \"wave\",\n    \"type\": \"fc\",\n    \"time\": \"00\",\n    \"step\": \"0\",\n    \"levtype\": \"sfc\",\n#    \"levelist\": \"\",\n#    \"param\": \"168\"   \n}  # Request configuration for the listener\n","visibility":"show","key":"NQLlvf85QS"},{"type":"output","id":"OgXrNHA6oEL16XJ2TK5dA","data":[],"visibility":"show","key":"W9ONDifjED"}],"visibility":"show","key":"NVkwUdBxIX"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"children":[{"type":"text","value":"Aviso configuration","key":"nhrHLAcCCE"}],"identifier":"aviso-configuration","label":"Aviso configuration","html_id":"aviso-configuration","implicit":true,"key":"HyaxOQgEVk"}],"key":"lCiUPAQUKj"},{"type":"block","kind":"notebook-code","data":{"tags":[]},"children":[{"type":"code","lang":"python","executable":true,"value":"CONFIG = {\n    \"notification_engine\": {\n        \"host\": \"aviso.lumi.apps.dte.destination-earth.eu\",\n        \"port\": 443,\n        \"https\": True,\n    },\n    \"configuration_engine\": {\n        \"host\": \"aviso.lumi.apps.dte.destination-earth.eu\",\n        \"port\": 443,\n        \"https\": True,\n    },\n    \"schema_parser\": \"generic\",\n    \"remote_schema\": True,\n    \"auth_type\": \"none\",\n    \"quiet\" : True\n}  # manually defined configuration\n","visibility":"show","key":"ohaaClGOox"},{"type":"output","id":"F2d3C7MBPgrbyhOYMZFEz","data":[],"visibility":"show","key":"OkehwmV0et"}],"visibility":"show","key":"DB2Ss3iKRD"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"children":[{"type":"text","value":"Searching for notifications","key":"vpYz7LE9Zo"}],"identifier":"searching-for-notifications","label":"Searching for notifications","html_id":"searching-for-notifications","implicit":true,"key":"D3CyrrtDow"},{"type":"paragraph","children":[{"type":"text","value":"Ssearching for notifications where available.","key":"BlPjiZpAI8"}],"key":"F4LqPhQOHs"}],"key":"vVoe7n5onn"},{"type":"block","kind":"notebook-code","data":{"tags":[]},"children":[{"type":"code","lang":"python","executable":true,"value":"\n\nEND_DATE = datetime.now()\nSTART_DATE = END_DATE - timedelta(days=14)\n","visibility":"show","key":"NuqRI8F4BC"},{"type":"output","id":"eus-2zbC3kkiuPuF2owrP","data":[],"visibility":"show","key":"AabOik9jqo"}],"visibility":"show","key":"PQue3jh1Ok"},{"type":"block","kind":"notebook-code","data":{"tags":[]},"children":[{"type":"code","lang":"python","executable":true,"value":"def triggered_function(notification):\n    \"\"\"\n    Function for the listener to trigger.\n    \"\"\"\n    \n    #pp(notification)\n    # Access the date field\n    date_str = notification['request']['date']    \n\n    # Convert the date string to a datetime object\n    date_obj = datetime.strptime(date_str, '%Y%m%d')\n    formatted_date = date_obj.strftime('%Y-%m-%d')\n    pp(\"ExtremeDT data available=>\" + formatted_date)\n    \n    ","visibility":"show","key":"vq2yrcAoEU"},{"type":"output","id":"XQAGKGH244FRy_n61Cu1q","data":[],"visibility":"show","key":"iW5xMrb2Qx"}],"visibility":"show","key":"jI25bsdkmg"},{"type":"block","kind":"notebook-code","data":{"tags":[]},"children":[{"type":"code","lang":"python","executable":true,"value":"def create_hist_listener():\n    \"\"\"\n    Creates and returns a listener configuration.\n    \"\"\"\n\n    trigger = {\n        \"type\": TRIGGER_TYPE,\n        \"function\": triggered_function,\n    }  # Define the trigger for the listener\n    \n    # Return the complete listener configuration\n    return {\"event\": LISTENER_EVENT, \"request\": REQUEST, \"triggers\": [trigger]}\n","visibility":"show","key":"LIDIL4g6rf"},{"type":"output","id":"iNOW_h-UxIUY5VeNMb5wz","data":[],"visibility":"show","key":"PL3II737ko"}],"visibility":"show","key":"AQUrQMvUXg"},{"type":"block","kind":"notebook-code","data":{"tags":[]},"children":[{"type":"code","lang":"python","executable":true,"value":"try:\n    listener = create_hist_listener()  # Create listener configuration\n    listeners_config = {\"listeners\": [listener]}  # Define listeners configuration\n    config = user_config.UserConfig(**CONFIG)\n    print(\"loaded config:\")\n    pp(CONFIG)\n    nmh = NotificationManager()  # Initialize the NotificationManager\n\n    nmh.listen(\n        listeners=listeners_config, from_date=START_DATE,to_date=END_DATE, config=config\n    )  # Start listening\nexcept Exception as e:\n    print(f\"Failed to initialize the Notification Manager: {e}\")","visibility":"show","key":"NgSgF78vka"},{"type":"output","id":"jqeoZFn_x2ny-PIUswBbD","data":[{"name":"stdout","output_type":"stream","text":"loaded config:\n{'auth_type': 'none',\n 'configuration_engine': {'host': 'aviso.lumi.apps.dte.destination-earth.eu',\n                          'https': True,\n                          'port': 443},\n 'notification_engine': {'host': 'aviso.lumi.apps.dte.destination-earth.eu',\n                         'https': True,\n                         'port': 443},\n 'quiet': True,\n 'remote_schema': True,\n 'schema_parser': 'generic'}\n'ExtremeDT data available=>2026-11-01'\n'ExtremeDT data available=>2026-10-29'\n'ExtremeDT data available=>2026-10-28'\n'ExtremeDT data available=>2026-10-27'\n'ExtremeDT data available=>2026-10-26'\n'ExtremeDT data available=>2026-10-25'\n'ExtremeDT da