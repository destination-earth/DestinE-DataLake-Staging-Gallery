ing","depth":2,"children":[{"type":"text","value":"Defining the data to be notified","key":"DE8s1J0L60"}],"identifier":"defining-the-data-to-be-notified","label":"Defining the data to be notified","html_id":"defining-the-data-to-be-notified","implicit":true,"key":"enrBs56ouv"},{"type":"paragraph","children":[{"type":"text","value":"The following request describes the data whose availability we want to be notified","key":"WJLdaIbKvR"}],"key":"A0cywf6lcZ"}],"key":"AR2Gp5MvXO"},{"type":"block","kind":"notebook-code","data":{"tags":[]},"children":[{"type":"code","lang":"python","executable":true,"value":"REQUEST = {\n    \"class\": \"d1\",\n    \"expver\": \"0001\",\n    \"stream\": \"wave\",\n    \"type\": \"fc\",\n    \"time\": \"00\",\n    \"step\": \"0\",\n    \"levtype\": \"sfc\",\n#    \"levelist\": \"\",\n#    \"param\": \"168\"   \n}  # Request configuration for the listener\n","visibility":"show","key":"xLoGT5hP3m"},{"type":"output","id":"q4XPVTtg2lYAo09Lyhbaf","data":[],"visibility":"show","key":"wPocyBmjpr"}],"visibility":"show","key":"rTNbVlGwjx"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"children":[{"type":"text","value":"Aviso configuration","key":"otVWNkZZwK"}],"identifier":"aviso-configuration","label":"Aviso configuration","html_id":"aviso-configuration","implicit":true,"key":"N6QprPWASh"}],"key":"s0tF7re4dI"},{"type":"block","kind":"notebook-code","data":{"tags":[]},"children":[{"type":"code","lang":"python","executable":true,"value":"CONFIG = {\n    \"notification_engine\": {\n        \"host\": \"aviso.lumi.apps.dte.destination-earth.eu\",\n        \"port\": 443,\n        \"https\": True,\n    },\n    \"configuration_engine\": {\n        \"host\": \"aviso.lumi.apps.dte.destination-earth.eu\",\n        \"port\": 443,\n        \"https\": True,\n    },\n    \"schema_parser\": \"generic\",\n    \"remote_schema\": True,\n    \"auth_type\": \"none\",\n    \"quiet\" : True\n}  # manually defined configuration\n","visibility":"show","key":"ticoqZL3a1"},{"type":"output","id":"4sOCpPqg4zHXiOhUOlnKz","data":[],"visibility":"show","key":"nxkJdfOLZS"}],"visibility":"show","key":"ZBruVuAnPA"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"children":[{"type":"text","value":"Searching for notifications","key":"uifSxhJRDI"}],"identifier":"searching-for-notifications","label":"Searching for notifications","html_id":"searching-for-notifications","implicit":true,"key":"zhf65eeXV9"},{"type":"paragraph","children":[{"type":"text","value":"Ssearching for notifications where available.","key":"Xtxg0fQfUi"}],"key":"qz8lMeKQ8z"}],"key":"AcWn1sD9ol"},{"type":"block","kind":"notebook-code","data":{"tags":[]},"children":[{"type":"code","lang":"python","executable":true,"value":"\n\nEND_DATE = datetime.now()\nSTART_DATE = END_DATE - timedelta(days=14)\n","visibility":"show","key":"nr6qevegy4"},{"type":"output","id":"ZvCvC3EuoySsjFOb1VDSo","data":[],"visibility":"show","key":"rCJeYxiCds"}],"visibility":"show","key":"Fs905ysYTe"},{"type":"block","kind":"notebook-code","data":{"tags":[]},"children":[{"type":"code","lang":"python","executable":true,"value":"def triggered_function(notification):\n    \"\"\"\n    Function for the listener to trigger.\n    \"\"\"\n    \n    #pp(notification)\n    # Access the date field\n    date_str = notification['request']['date']    \n\n    # Convert the date string to a datetime object\n    date_obj = datetime.strptime(date_str, '%Y%m%d')\n    formatted_date = date_obj.strftime('%Y-%m-%d')\n    pp(\"ExtremeDT data available=>\" + formatted_date)\n    \n    ","visibility":"show","key":"j8KEj2m4mL"},{"type":"output","id":"o2Cb3fvQ5JA5wuXkxB6L6","data":[],"visibility":"show","key":"iNDtnLTQ8p"}],"visibility":"show","key":"WR7dViUZEs"},{"type":"block","kind":"notebook-code","data":{"tags":[]},"children":[{"type":"code","lang":"python","executable":true,"value":"def create_hist_listener():\n    \"\"\"\n    Creates and returns a listener configuration.\n    \"\"\"\n\n    trigger = {\n        \"type\": TRIGGER_TYPE,\n        \"function\": triggered_function,\n    }  # Define the trigger for the listener\n    \n    # Return the complete listener configuration\n    return {\"event\": LISTENER_EVENT, \"request\": REQUEST, \"triggers\": [trigger]}\n","visibility":"show","key":"WKZj1mNRX8"},{"type":"output","id":"FsN09TUhfaiTBB8iqFPLI","data":[],"visibility":"show","key":"AsPPR2KdFu"}],"visibility":"show","key":"qF6R2EvPAd"},{"type":"block","kind":"notebook-code","data":{"tags":[]},"children":[{"type":"code","lang":"python","executable":true,"value":"try:\n    listener = create_hist_listener()  # Create listener configuration\n    listeners_config = {\"listeners\": [listener]}  # Define listeners configuration\n    config = user_config.UserConfig(**CONFIG)\n    print(\"loaded config:\")\n    pp(CONFIG)\n    nmh = NotificationManager()  # Initialize the NotificationManager\n\n    nmh.listen(\n        listeners=listeners_config, from_date=START_DATE,to_date=END_DATE, config=config\n    )  # Start listening\nexcept Exception as e:\n    print(f\"Failed to initialize the Notification Manager: {e}\")","visibility":"show","key":"rBnJQAVJrH"},{"type":"output","id":"rkks6lmBqAdVNWkmawijX","data":[{"name":"stdout","output_type":"stream","text":"loaded config:\n{'auth_type': 'none',\n 'configuration_engine': {'host': 'aviso.lumi.apps.dte.destination-earth.eu',\n                          'https': True,\n                          'port': 443},\n 'notification_engine': {'host': 'aviso.lumi.apps.dte.destination-earth.eu',\n                         'https': True,\n                         'port': 443},\n 'quiet': True,\n 'remote_schema': True,\n 'schema_parser': 'generic'}\n'ExtremeDT data available=>2026-07-17'\n'ExtremeDT data available=>2026-07-16'\n'ExtremeDT data available=>2026-07-15'\n'ExtremeDT data available=>2026-07-14'\n'ExtremeDT data available=>2026-07-13'\n'ExtremeDT data available=>2026-07-12'\n'ExtremeDT da