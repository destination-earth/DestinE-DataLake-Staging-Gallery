r(pyaviso))\n","key":"lKuG3W8z7i"},{"type":"output","id":"dwkZvBUwniCwwx9gJrlxT","data":[{"name":"stdout","output_type":"stream","text":"1.0.2\n['HOME_FOLDER', 'NotificationManager', 'Queue', 'SYSTEM_FOLDER', '__builtins__', '__cached__', '__doc__', '__file__', '__loader__', '__name__', '__package__', '__path__', '__spec__', '__version__', 'authentication', 'custom_exceptions', 'engine', 'event_listeners', 'exit_channel', 'logger', 'logging', 'notification_manager', 'triggers', 'user_config', 'version']\n"}],"key":"oNwjPPERWO"}],"key":"Nc5nVlyRyb"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"children":[{"type":"text","value":"Import pyaviso","key":"r5rrAor3bb"}],"identifier":"import-pyaviso","label":"Import pyaviso","html_id":"import-pyaviso","implicit":true,"key":"Ohvcs7jZRL"},{"type":"paragraph","children":[{"type":"text","value":"Import pyaviso and other useful libraries. Defining constants and functions.","key":"DZYHoXtf1V"}],"key":"uy5EED0dG3"}],"key":"uG4zZNth3k"},{"type":"block","kind":"notebook-code","data":{"tags":[]},"children":[{"type":"code","lang":"python","executable":true,"value":"import sys\n\nfrom datetime import datetime, timedelta\nfrom pprint import pprint as pp\n\nfrom pyaviso import NotificationManager, user_config","visibility":"show","key":"gBPlVkoLGU"},{"type":"output","id":"2E1W8dpcZUEjdyUAyutPs","data":[],"visibility":"show","key":"UaMlyXL3nt"}],"visibility":"show","key":"rofGM0tB70"},{"type":"block","kind":"notebook-code","data":{"tags":[]},"children":[{"type":"code","lang":"python","executable":true,"value":"LISTENER_EVENT = \"data\"  # Event for the listener, options are mars and dissemination\nTRIGGER_TYPE = \"function\"  # Type of trigger for the listener","visibility":"show","key":"AfpHFuVxZr"},{"type":"output","id":"VwbEOGrz8CHJXqhEKplcj","data":[],"visibility":"show","key":"nHvg5KzNsC"}],"visibility":"show","key":"GZNFok8gEb"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"children":[{"type":"text","value":"Defining the data to be notified","key":"fu4w9515D5"}],"identifier":"defining-the-data-to-be-notified","label":"Defining the data to be notified","html_id":"defining-the-data-to-be-notified","implicit":true,"key":"Xcd9BsJE1Z"},{"type":"paragraph","children":[{"type":"text","value":"The following request describes the data whose availability we want to be notified","key":"Ees0CnR1jZ"}],"key":"H29ywqUG5M"}],"key":"pfecSLvRLV"},{"type":"block","kind":"notebook-code","data":{"tags":[]},"children":[{"type":"code","lang":"python","executable":true,"value":"REQUEST = {\n    \"class\": \"d1\",\n    \"expver\": \"0001\",\n    \"stream\": \"wave\",\n    \"type\": \"fc\",\n    \"time\": \"00\",\n    \"step\": \"0\",\n    \"levtype\": \"sfc\",\n#    \"levelist\": \"\",\n#    \"param\": \"168\"   \n}  # Request configuration for the listener\n","visibility":"show","key":"rMBPFGlDJI"},{"type":"output","id":"iu8cA70YQXGngTejM_RwT","data":[],"visibility":"show","key":"KBNyJm4NzV"}],"visibility":"show","key":"OLwCjZ2SI4"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"children":[{"type":"text","value":"Aviso configuration","key":"GJJKTv49gr"}],"identifier":"aviso-configuration","label":"Aviso configuration","html_id":"aviso-configuration","implicit":true,"key":"RLXp51ZJwR"}],"key":"NvzSJzCx0m"},{"type":"block","kind":"notebook-code","data":{"tags":[]},"children":[{"type":"code","lang":"python","executable":true,"value":"CONFIG = {\n    \"notification_engine\": {\n        \"host\": \"aviso.lumi.apps.dte.destination-earth.eu\",\n        \"port\": 443,\n        \"https\": True,\n    },\n    \"configuration_engine\": {\n        \"host\": \"aviso.lumi.apps.dte.destination-earth.eu\",\n        \"port\": 443,\n        \"https\": True,\n    },\n    \"schema_parser\": \"generic\",\n    \"remote_schema\": True,\n    \"auth_type\": \"none\",\n    \"quiet\" : True\n}  # manually defined configuration\n","visibility":"show","key":"NW5U4zHrv2"},{"type":"output","id":"RL6kKggTB_D_I7zHclXuy","data":[],"visibility":"show","key":"VIjoqkpjxW"}],"visibility":"show","key":"BX6mp6w7z7"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"children":[{"type":"text","value":"Searching for notifications","key":"zwTahD5lfd"}],"identifier":"searching-for-notifications","label":"Searching for notifications","html_id":"searching-for-notifications","implicit":true,"key":"JQgMLKp2qO"},{"type":"paragraph","children":[{"type":"text","value":"Ssearching for notifications where available.","key":"QWbmMT1ZU0"}],"key":"M5EKmdelD6"}],"key":"RfV0RZFOrU"},{"type":"block","kind":"notebook-code","data":{"tags":[]},"children":[{"type":"code","lang":"python","executable":true,"value":"\n\nEND_DATE = datetime.now()\nSTART_DATE = END_DATE - timedelta(days=14)\n","visibility":"show","key":"AqhxSl9Hsk"},{"type":"output","id":"jL7iWTFq4rdjOXWv9w3nN","data":[],"visibility":"show","key":"A6ZD5fu8YR"}],"visibility":"show","key":"huqW35JvEA"},{"type":"block","kind":"notebook-code","data":{"tags":[]},"children":[{"type":"code","lang":"python","executable":true,"value":"def triggered_function(notification):\n    \"\"\"\n    Function for the listener to trigger.\n    \"\"\"\n    \n    #pp(notification)\n    # Access the date field\n    date_str = notification['request']['date']    \n\n    # Convert the date string to a datetime object\n    date_obj = datetime.strptime(date_str, '%Y%m%d')\n    formatted_date = date_obj.strftime('%Y-%m-%d')\n    pp(\"ExtremeDT data available=>\" + formatted_date)\n    \n    ","visibility":"show","key":"Y558yNwYyB"},{"type":"output","id":"Xs42XpXK6-3OCCsWxjCN3","data":[],"visibility":"show","key":"yj62DADgQ1"}],"visibility":"show","key":"PeCotTNGE8"},{"type":"block","kind":"notebook-code","data":{"tags":[]},"children":[{"type":"code","lang":"python","executable":true,"value":"def create_hist_listener():\n    \"\"\"\n    Creates and returns a listener configuration.\n    \"\"\"\n\n    trigger = {\n        \"type\": TRIGGER_TYPE,\n        \"function\": triggered_function,\n    }  # Define the trigger for the listener\n    \n    # Return the complete listener configuration\n    return {\"event\": LISTENER_EVENT, \"request\": REQUEST, \"triggers\": [trigger]}\n","visibility":"show","key":"C7KEBd8Bxu"},{"type":"output","id":"ISmeqCSPLU3AaKd-O__G8","data":[],"visibility":"show","key":"yCvEb2Rvul"}],"visibility":"show","key":"kOpsbvJ83i"},{"type":"block","kind":"notebook-code","data":{"tags":[]},"children":[{"type":"code","lang":"python","executable":true,"value":"try:\n    listener = create_hist_listener()  # Create listener configuration\n    listeners_config = {\"listeners\": [listener]}  # Define listeners configuration\n    config = user_config.UserConfig(**CONFIG)\n    print(\"loaded config:\")\n    pp(CONFIG)\n    nmh = NotificationManager()  # Initialize the NotificationManager\n\n    nmh.listen(\n        listeners=listeners_config, from_date=START_DATE,to_date=END_DATE, config=config\n    )  # Start listening\nexcept Exception as e:\n    print(f\"Failed to initialize the Notification Manager: {e}\")","visibility":"show","key":"uJUyI2Qkkl"},{"type":"output","id":"L77o6jFveaKuO2aTWLucC","data":[{"name":"stdout","output_type":"stream","text":"loaded config:\n{'auth_type': 'none',\n 'configuration_engine': {'host': 'aviso.lumi.apps.dte.destination-earth.eu',\n                          'https': True,\n                          'port': 443},\n 'notification_engine': {'host': 'aviso.lumi.apps.dte.destination-earth.eu',\n                         'https': True,\n                         'port': 443},\n 'quiet': True,\n 'remote_schema': True,\n 'schema_parser': 'generic'}\n'ExtremeDT data available=>2026-07-27'\n'ExtremeDT data available=>2026-07-26'\n'ExtremeDT data available=>2026-07-25'\n'ExtremeDT data available=>2026-07-24'\n'ExtremeDT data available=>2026-07-23'\n'ExtremeDT data available=>2026-07-22'\n'ExtremeDT da