ing","depth":2,"children":[{"type":"text","value":"Defining the data to be notified","key":"Sex9JJdSuk"}],"identifier":"defining-the-data-to-be-notified","label":"Defining the data to be notified","html_id":"defining-the-data-to-be-notified","implicit":true,"key":"PpJXBFQCoq"},{"type":"paragraph","children":[{"type":"text","value":"The following request describes the data whose availability we want to be notified","key":"k7gaPxbGHs"}],"key":"ONImpCPDZE"}],"key":"wX3vvSI9t5"},{"type":"block","kind":"notebook-code","data":{"tags":[]},"children":[{"type":"code","lang":"python","executable":true,"value":"REQUEST = {\n    \"class\": \"d1\",\n    \"expver\": \"0001\",\n    \"stream\": \"wave\",\n    \"type\": \"fc\",\n    \"time\": \"00\",\n    \"step\": \"0\",\n    \"levtype\": \"sfc\",\n#    \"levelist\": \"\",\n#    \"param\": \"168\"   \n}  # Request configuration for the listener\n","visibility":"show","key":"UgCkekGQ1T"},{"type":"output","id":"IEB0FrT3q0_RKx2jcYNCs","data":[],"visibility":"show","key":"j5fHdJ9zRE"}],"visibility":"show","key":"qg1B1L5re7"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"children":[{"type":"text","value":"Aviso configuration","key":"a8fbwG5UHq"}],"identifier":"aviso-configuration","label":"Aviso configuration","html_id":"aviso-configuration","implicit":true,"key":"nTkuLAN4rE"}],"key":"A9wuCtqndK"},{"type":"block","kind":"notebook-code","data":{"tags":[]},"children":[{"type":"code","lang":"python","executable":true,"value":"CONFIG = {\n    \"notification_engine\": {\n        \"host\": \"aviso.lumi.apps.dte.destination-earth.eu\",\n        \"port\": 443,\n        \"https\": True,\n    },\n    \"configuration_engine\": {\n        \"host\": \"aviso.lumi.apps.dte.destination-earth.eu\",\n        \"port\": 443,\n        \"https\": True,\n    },\n    \"schema_parser\": \"generic\",\n    \"remote_schema\": True,\n    \"auth_type\": \"none\",\n    \"quiet\" : True\n}  # manually defined configuration\n","visibility":"show","key":"ZPlPJQRO9N"},{"type":"output","id":"L-eS11Hq5bxleqM3TRLjj","data":[],"visibility":"show","key":"t9xV7HEDdz"}],"visibility":"show","key":"J2gv4fv9FY"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"children":[{"type":"text","value":"Searching for notifications","key":"QiZZMrPWrj"}],"identifier":"searching-for-notifications","label":"Searching for notifications","html_id":"searching-for-notifications","implicit":true,"key":"hDPlGrSglZ"},{"type":"paragraph","children":[{"type":"text","value":"Ssearching for notifications where available.","key":"OepGxkfvPk"}],"key":"E246N8yW5J"}],"key":"XobQ4dApYo"},{"type":"block","kind":"notebook-code","data":{"tags":[]},"children":[{"type":"code","lang":"python","executable":true,"value":"\n\nEND_DATE = datetime.now()\nSTART_DATE = END_DATE - timedelta(days=14)\n","visibility":"show","key":"dctIc3FqET"},{"type":"output","id":"ZTqinVyN3AgA8zhUK3zzi","data":[],"visibility":"show","key":"ZlGsjpDJJo"}],"visibility":"show","key":"PSFdjzlFW0"},{"type":"block","kind":"notebook-code","data":{"tags":[]},"children":[{"type":"code","lang":"python","executable":true,"value":"def triggered_function(notification):\n    \"\"\"\n    Function for the listener to trigger.\n    \"\"\"\n    \n    #pp(notification)\n    # Access the date field\n    date_str = notification['request']['date']    \n\n    # Convert the date string to a datetime object\n    date_obj = datetime.strptime(date_str, '%Y%m%d')\n    formatted_date = date_obj.strftime('%Y-%m-%d')\n    pp(\"ExtremeDT data available=>\" + formatted_date)\n    \n    ","visibility":"show","key":"rAOBE5g0D7"},{"type":"output","id":"lL5-1ic2DsNU11su7QNfK","data":[],"visibility":"show","key":"LaQeRm026T"}],"visibility":"show","key":"xXQtv4yDmR"},{"type":"block","kind":"notebook-code","data":{"tags":[]},"children":[{"type":"code","lang":"python","executable":true,"value":"def create_hist_listener():\n    \"\"\"\n    Creates and returns a listener configuration.\n    \"\"\"\n\n    trigger = {\n        \"type\": TRIGGER_TYPE,\n        \"function\": triggered_function,\n    }  # Define the trigger for the listener\n    \n    # Return the complete listener configuration\n    return {\"event\": LISTENER_EVENT, \"request\": REQUEST, \"triggers\": [trigger]}\n","visibility":"show","key":"ksyEpPfAgD"},{"type":"output","id":"_DL-4i5tW_qWdfQP1u2hV","data":[],"visibility":"show","key":"Qvy0lhxuXc"}],"visibility":"show","key":"nAZXRt4jyC"},{"type":"block","kind":"notebook-code","data":{"tags":[]},"children":[{"type":"code","lang":"python","executable":true,"value":"try:\n    listener = create_hist_listener()  # Create listener configuration\n    listeners_config = {\"listeners\": [listener]}  # Define listeners configuration\n    config = user_config.UserConfig(**CONFIG)\n    print(\"loaded config:\")\n    pp(CONFIG)\n    nmh = NotificationManager()  # Initialize the NotificationManager\n\n    nmh.listen(\n        listeners=listeners_config, from_date=START_DATE,to_date=END_DATE, config=config\n    )  # Start listening\nexcept Exception as e:\n    print(f\"Failed to initialize the Notification Manager: {e}\")","visibility":"show","key":"OrdjttAAvA"},{"type":"output","id":"23PcclyMopvUjg9xrx3iL","data":[{"name":"stdout","output_type":"stream","text":"loaded config:\n{'auth_type': 'none',\n 'configuration_engine': {'host': 'aviso.lumi.apps.dte.destination-earth.eu',\n                          'https': True,\n                          'port': 443},\n 'notification_engine': {'host': 'aviso.lumi.apps.dte.destination-earth.eu',\n                         'https': True,\n                         'port': 443},\n 'quiet': True,\n 'remote_schema': True,\n 'schema_parser': 'generic'}\n'ExtremeDT data available=>2026-07-27'\n'ExtremeDT data available=>2026-07-26'\n'ExtremeDT data available=>2026-07-25'\n'ExtremeDT data available=>2026-07-24'\n'ExtremeDT data available=>2026-07-23'\n'ExtremeDT data available=>2026-07-22'\n'ExtremeDT da