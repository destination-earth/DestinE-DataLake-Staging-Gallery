ing","depth":2,"children":[{"type":"text","value":"Defining the data to be notified","key":"c00TaYFAEJ"}],"identifier":"defining-the-data-to-be-notified","label":"Defining the data to be notified","html_id":"defining-the-data-to-be-notified","implicit":true,"key":"do0Ts7sjYw"},{"type":"paragraph","children":[{"type":"text","value":"The following request describes the data whose availability we want to be notified","key":"qSPpMjlGrw"}],"key":"TbqYJrPp7E"}],"key":"J9YYF8v6jU"},{"type":"block","kind":"notebook-code","data":{"tags":[]},"children":[{"type":"code","lang":"python","executable":true,"value":"REQUEST = {\n    \"class\": \"d1\",\n    \"expver\": \"0001\",\n    \"stream\": \"wave\",\n    \"type\": \"fc\",\n    \"time\": \"00\",\n    \"step\": \"0\",\n    \"levtype\": \"sfc\",\n#    \"levelist\": \"\",\n#    \"param\": \"168\"   \n}  # Request configuration for the listener\n","visibility":"show","key":"Cv6d3nkIyR"},{"type":"output","id":"ceCwquhwwA5L_Bwrx8r11","data":[],"visibility":"show","key":"ZjuKZwWyee"}],"visibility":"show","key":"Qbnn22Qehf"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"children":[{"type":"text","value":"Aviso configuration","key":"nigpXA7M76"}],"identifier":"aviso-configuration","label":"Aviso configuration","html_id":"aviso-configuration","implicit":true,"key":"R4JhkpMRam"}],"key":"bf8DFmyw6M"},{"type":"block","kind":"notebook-code","data":{"tags":[]},"children":[{"type":"code","lang":"python","executable":true,"value":"CONFIG = {\n    \"notification_engine\": {\n        \"host\": \"aviso.lumi.apps.dte.destination-earth.eu\",\n        \"port\": 443,\n        \"https\": True,\n    },\n    \"configuration_engine\": {\n        \"host\": \"aviso.lumi.apps.dte.destination-earth.eu\",\n        \"port\": 443,\n        \"https\": True,\n    },\n    \"schema_parser\": \"generic\",\n    \"remote_schema\": True,\n    \"auth_type\": \"none\",\n    \"quiet\" : True\n}  # manually defined configuration\n","visibility":"show","key":"KQEhoW1hDM"},{"type":"output","id":"55_ae_C7oGiJ9QUD06wwB","data":[],"visibility":"show","key":"q4mAvgRRqf"}],"visibility":"show","key":"Z90Nk8pDTe"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"children":[{"type":"text","value":"Searching for notifications","key":"KEsSylSfoE"}],"identifier":"searching-for-notifications","label":"Searching for notifications","html_id":"searching-for-notifications","implicit":true,"key":"fFeVLB4e1c"},{"type":"paragraph","children":[{"type":"text","value":"Ssearching for notifications where available.","key":"cahyIes2rA"}],"key":"aQrWz4Hn7w"}],"key":"bE9zupddw8"},{"type":"block","kind":"notebook-code","data":{"tags":[]},"children":[{"type":"code","lang":"python","executable":true,"value":"\n\nEND_DATE = datetime.now()\nSTART_DATE = END_DATE - timedelta(days=14)\n","visibility":"show","key":"SRS1fGxQWk"},{"type":"output","id":"KWw0JQCFNjqHyTjDGkbpA","data":[],"visibility":"show","key":"TdKQDTx9sF"}],"visibility":"show","key":"jE3IP4qbko"},{"type":"block","kind":"notebook-code","data":{"tags":[]},"children":[{"type":"code","lang":"python","executable":true,"value":"def triggered_function(notification):\n    \"\"\"\n    Function for the listener to trigger.\n    \"\"\"\n    \n    #pp(notification)\n    # Access the date field\n    date_str = notification['request']['date']    \n\n    # Convert the date string to a datetime object\n    date_obj = datetime.strptime(date_str, '%Y%m%d')\n    formatted_date = date_obj.strftime('%Y-%m-%d')\n    pp(\"ExtremeDT data available=>\" + formatted_date)\n    \n    ","visibility":"show","key":"rNQnZ7gfMs"},{"type":"output","id":"jtbS4Ejh8xmZWbQKRibXZ","data":[],"visibility":"show","key":"PBidHxZXJA"}],"visibility":"show","key":"AGmnzNIrXE"},{"type":"block","kind":"notebook-code","data":{"tags":[]},"children":[{"type":"code","lang":"python","executable":true,"value":"def create_hist_listener():\n    \"\"\"\n    Creates and returns a listener configuration.\n    \"\"\"\n\n    trigger = {\n        \"type\": TRIGGER_TYPE,\n        \"function\": triggered_function,\n    }  # Define the trigger for the listener\n    \n    # Return the complete listener configuration\n    return {\"event\": LISTENER_EVENT, \"request\": REQUEST, \"triggers\": [trigger]}\n","visibility":"show","key":"LTnBel0IO8"},{"type":"output","id":"9hDVx7l-jPNYoMOcdIWiX","data":[],"visibility":"show","key":"CYzwwBth7W"}],"visibility":"show","key":"yZCxeyUpwE"},{"type":"block","kind":"notebook-code","data":{"tags":[]},"children":[{"type":"code","lang":"python","executable":true,"value":"try:\n    listener = create_hist_listener()  # Create listener configuration\n    listeners_config = {\"listeners\": [listener]}  # Define listeners configuration\n    config = user_config.UserConfig(**CONFIG)\n    print(\"loaded config:\")\n    pp(CONFIG)\n    nmh = NotificationManager()  # Initialize the NotificationManager\n\n    nmh.listen(\n        listeners=listeners_config, from_date=START_DATE,to_date=END_DATE, config=config\n    )  # Start listening\nexcept Exception as e:\n    print(f\"Failed to initialize the Notification Manager: {e}\")","visibility":"show","key":"xvJxhLWbqw"},{"type":"output","id":"miqvMVkIRkoRmbCXpx41D","data":[{"name":"stdout","output_type":"stream","text":"loaded config:\n{'auth_type': 'none',\n 'configuration_engine': {'host': 'aviso.lumi.apps.dte.destination-earth.eu',\n                          'https': True,\n                          'port': 443},\n 'notification_engine': {'host': 'aviso.lumi.apps.dte.destination-earth.eu',\n                         'https': True,\n                         'port': 443},\n 'quiet': True,\n 'remote_schema': True,\n 'schema_parser': 'generic'}\n'ExtremeDT data available=>2026-11-01'\n'ExtremeDT data available=>2026-10-29'\n'ExtremeDT data available=>2026-10-28'\n'ExtremeDT data available=>2026-10-27'\n'ExtremeDT data available=>2026-10-26'\n'ExtremeDT data available=>2026-10-25'\n'ExtremeDT da