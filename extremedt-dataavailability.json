ing","depth":2,"children":[{"type":"text","value":"Defining the data to be notified","key":"OOxlUisSuH"}],"identifier":"defining-the-data-to-be-notified","label":"Defining the data to be notified","html_id":"defining-the-data-to-be-notified","implicit":true,"key":"ei0OYnb5op"},{"type":"paragraph","children":[{"type":"text","value":"The following request describes the data whose availability we want to be notified","key":"TRA6nudwcR"}],"key":"DRCA4znwnQ"}],"key":"ajIAgoRgaR"},{"type":"block","kind":"notebook-code","data":{"tags":[]},"children":[{"type":"code","lang":"python","executable":true,"value":"REQUEST = {\n    \"class\": \"d1\",\n    \"expver\": \"0001\",\n    \"stream\": \"wave\",\n    \"type\": \"fc\",\n    \"time\": \"00\",\n    \"step\": \"0\",\n    \"levtype\": \"sfc\",\n#    \"levelist\": \"\",\n#    \"param\": \"168\"   \n}  # Request configuration for the listener\n","visibility":"show","key":"lyEN6KpBHu"},{"type":"output","id":"A6j03h58woUMN2-uVAo38","data":[],"visibility":"show","key":"mPuYCsPOiq"}],"visibility":"show","key":"pFA5T1wTEM"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"children":[{"type":"text","value":"Aviso configuration","key":"Wk3Wel0qVq"}],"identifier":"aviso-configuration","label":"Aviso configuration","html_id":"aviso-configuration","implicit":true,"key":"hbbBoM7UFJ"}],"key":"zcsIixM0kx"},{"type":"block","kind":"notebook-code","data":{"tags":[]},"children":[{"type":"code","lang":"python","executable":true,"value":"CONFIG = {\n    \"notification_engine\": {\n        \"host\": \"aviso.lumi.apps.dte.destination-earth.eu\",\n        \"port\": 443,\n        \"https\": True,\n    },\n    \"configuration_engine\": {\n        \"host\": \"aviso.lumi.apps.dte.destination-earth.eu\",\n        \"port\": 443,\n        \"https\": True,\n    },\n    \"schema_parser\": \"generic\",\n    \"remote_schema\": True,\n    \"auth_type\": \"none\",\n    \"quiet\" : True\n}  # manually defined configuration\n","visibility":"show","key":"Ho8vS9hsbd"},{"type":"output","id":"LxTkK7NHR0ZuaqwXvJXZk","data":[],"visibility":"show","key":"rxLLqCtdFs"}],"visibility":"show","key":"RZDKR83Gov"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"children":[{"type":"text","value":"Searching for notifications","key":"YmaIQ9G0fk"}],"identifier":"searching-for-notifications","label":"Searching for notifications","html_id":"searching-for-notifications","implicit":true,"key":"cvtRYXPKLW"},{"type":"paragraph","children":[{"type":"text","value":"Ssearching for notifications where available.","key":"WLllH5ZLSL"}],"key":"bwI77VpMyf"}],"key":"dzOSKpwa3e"},{"type":"block","kind":"notebook-code","data":{"tags":[]},"children":[{"type":"code","lang":"python","executable":true,"value":"\n\nEND_DATE = datetime.now()\nSTART_DATE = END_DATE - timedelta(days=14)\n","visibility":"show","key":"DBLsbk0jc7"},{"type":"output","id":"E6th1vNJb_XNZaoUp43vc","data":[],"visibility":"show","key":"kFdYqQPxOP"}],"visibility":"show","key":"Q6yVZnIKL4"},{"type":"block","kind":"notebook-code","data":{"tags":[]},"children":[{"type":"code","lang":"python","executable":true,"value":"def triggered_function(notification):\n    \"\"\"\n    Function for the listener to trigger.\n    \"\"\"\n    \n    #pp(notification)\n    # Access the date field\n    date_str = notification['request']['date']    \n\n    # Convert the date string to a datetime object\n    date_obj = datetime.strptime(date_str, '%Y%m%d')\n    formatted_date = date_obj.strftime('%Y-%m-%d')\n    pp(\"ExtremeDT data available=>\" + formatted_date)\n    \n    ","visibility":"show","key":"MfgB0sL9rI"},{"type":"output","id":"GBIzYkm7xTUS4L92U2q06","data":[],"visibility":"show","key":"JG4CUPXE7l"}],"visibility":"show","key":"WFgLUmITh4"},{"type":"block","kind":"notebook-code","data":{"tags":[]},"children":[{"type":"code","lang":"python","executable":true,"value":"def create_hist_listener():\n    \"\"\"\n    Creates and returns a listener configuration.\n    \"\"\"\n\n    trigger = {\n        \"type\": TRIGGER_TYPE,\n        \"function\": triggered_function,\n    }  # Define the trigger for the listener\n    \n    # Return the complete listener configuration\n    return {\"event\": LISTENER_EVENT, \"request\": REQUEST, \"triggers\": [trigger]}\n","visibility":"show","key":"r3XjpG2Dca"},{"type":"output","id":"2owvVk7N7upSbSJrCyo5t","data":[],"visibility":"show","key":"IC6frMGzcG"}],"visibility":"show","key":"bwEMIQ29Cc"},{"type":"block","kind":"notebook-code","data":{"tags":[]},"children":[{"type":"code","lang":"python","executable":true,"value":"try:\n    listener = create_hist_listener()  # Create listener configuration\n    listeners_config = {\"listeners\": [listener]}  # Define listeners configuration\n    config = user_config.UserConfig(**CONFIG)\n    print(\"loaded config:\")\n    pp(CONFIG)\n    nmh = NotificationManager()  # Initialize the NotificationManager\n\n    nmh.listen(\n        listeners=listeners_config, from_date=START_DATE,to_date=END_DATE, config=config\n    )  # Start listening\nexcept Exception as e:\n    print(f\"Failed to initialize the Notification Manager: {e}\")","visibility":"show","key":"CkejuoDm8l"},{"type":"output","id":"CbRNwoifks_sq_D908az_","data":[{"name":"stdout","output_type":"stream","text":"loaded config:\n{'auth_type': 'none',\n 'configuration_engine': {'host': 'aviso.lumi.apps.dte.destination-earth.eu',\n                          'https': True,\n                          'port': 443},\n 'notification_engine': {'host': 'aviso.lumi.apps.dte.destination-earth.eu',\n                         'https': True,\n                         'port': 443},\n 'quiet': True,\n 'remote_schema': True,\n 'schema_parser': 'generic'}\n'ExtremeDT data available=>2026-07-27'\n'ExtremeDT data available=>2026-07-26'\n'ExtremeDT data available=>2026-07-25'\n'ExtremeDT data available=>2026-07-24'\n'ExtremeDT data available=>2026-07-23'\n'ExtremeDT data available=>2026-07-22'\n'ExtremeDT da