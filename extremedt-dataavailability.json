ing","depth":2,"children":[{"type":"text","value":"Defining the data to be notified","key":"aHFnAsCXEt"}],"identifier":"defining-the-data-to-be-notified","label":"Defining the data to be notified","html_id":"defining-the-data-to-be-notified","implicit":true,"key":"q5SLeX1mob"},{"type":"paragraph","children":[{"type":"text","value":"The following request describes the data whose availability we want to be notified","key":"NLbK4bXiE5"}],"key":"v3Bfz8ddY5"}],"key":"nySSaAOqip"},{"type":"block","kind":"notebook-code","data":{"tags":[]},"children":[{"type":"code","lang":"python","executable":true,"value":"REQUEST = {\n    \"class\": \"d1\",\n    \"expver\": \"0001\",\n    \"stream\": \"wave\",\n    \"type\": \"fc\",\n    \"time\": \"00\",\n    \"step\": \"0\",\n    \"levtype\": \"sfc\",\n#    \"levelist\": \"\",\n#    \"param\": \"168\"   \n}  # Request configuration for the listener\n","visibility":"show","key":"cs098zyfnk"},{"type":"output","id":"RnS67WsLXAJ7qVsOg0z70","data":[],"visibility":"show","key":"Gqdpk2oc4j"}],"visibility":"show","key":"V25VUZhhb4"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"children":[{"type":"text","value":"Aviso configuration","key":"yAjJoJxfl1"}],"identifier":"aviso-configuration","label":"Aviso configuration","html_id":"aviso-configuration","implicit":true,"key":"QCTbVgSNRP"}],"key":"u1ItvS4j1u"},{"type":"block","kind":"notebook-code","data":{"tags":[]},"children":[{"type":"code","lang":"python","executable":true,"value":"CONFIG = {\n    \"notification_engine\": {\n        \"host\": \"aviso.lumi.apps.dte.destination-earth.eu\",\n        \"port\": 443,\n        \"https\": True,\n    },\n    \"configuration_engine\": {\n        \"host\": \"aviso.lumi.apps.dte.destination-earth.eu\",\n        \"port\": 443,\n        \"https\": True,\n    },\n    \"schema_parser\": \"generic\",\n    \"remote_schema\": True,\n    \"auth_type\": \"none\",\n    \"quiet\" : True\n}  # manually defined configuration\n","visibility":"show","key":"onRlUFUPyr"},{"type":"output","id":"wfVw0WudWKo3dYmSnoSMl","data":[],"visibility":"show","key":"AcAaqPKMmo"}],"visibility":"show","key":"uvcGOhmACm"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"children":[{"type":"text","value":"Searching for notifications","key":"o0bpG5pnyH"}],"identifier":"searching-for-notifications","label":"Searching for notifications","html_id":"searching-for-notifications","implicit":true,"key":"hUCw2kX5cB"},{"type":"paragraph","children":[{"type":"text","value":"Ssearching for notifications where available.","key":"IMQxoqKB12"}],"key":"uY7vZcwA65"}],"key":"g3iRynHpKH"},{"type":"block","kind":"notebook-code","data":{"tags":[]},"children":[{"type":"code","lang":"python","executable":true,"value":"\n\nEND_DATE = datetime.now()\nSTART_DATE = END_DATE - timedelta(days=14)\n","visibility":"show","key":"hMy2Y1EBrp"},{"type":"output","id":"tWqI4Uh8AsVFIXp6A_ILs","data":[],"visibility":"show","key":"z2mZ9sxWQz"}],"visibility":"show","key":"sHq2z5ZlwK"},{"type":"block","kind":"notebook-code","data":{"tags":[]},"children":[{"type":"code","lang":"python","executable":true,"value":"def triggered_function(notification):\n    \"\"\"\n    Function for the listener to trigger.\n    \"\"\"\n    \n    #pp(notification)\n    # Access the date field\n    date_str = notification['request']['date']    \n\n    # Convert the date string to a datetime object\n    date_obj = datetime.strptime(date_str, '%Y%m%d')\n    formatted_date = date_obj.strftime('%Y-%m-%d')\n    pp(\"ExtremeDT data available=>\" + formatted_date)\n    \n    ","visibility":"show","key":"rIG5Y9jTaM"},{"type":"output","id":"dJkWujKC3kORlY-NskCVh","data":[],"visibility":"show","key":"aQuQKY41Bx"}],"visibility":"show","key":"s0bS56hOYj"},{"type":"block","kind":"notebook-code","data":{"tags":[]},"children":[{"type":"code","lang":"python","executable":true,"value":"def create_hist_listener():\n    \"\"\"\n    Creates and returns a listener configuration.\n    \"\"\"\n\n    trigger = {\n        \"type\": TRIGGER_TYPE,\n        \"function\": triggered_function,\n    }  # Define the trigger for the listener\n    \n    # Return the complete listener configuration\n    return {\"event\": LISTENER_EVENT, \"request\": REQUEST, \"triggers\": [trigger]}\n","visibility":"show","key":"ZKNcB3JXss"},{"type":"output","id":"n5zyXrXUAUAPVOLO4oT-i","data":[],"visibility":"show","key":"LeyVR2lmPu"}],"visibility":"show","key":"REznDsTaDw"},{"type":"block","kind":"notebook-code","data":{"tags":[]},"children":[{"type":"code","lang":"python","executable":true,"value":"try:\n    listener = create_hist_listener()  # Create listener configuration\n    listeners_config = {\"listeners\": [listener]}  # Define listeners configuration\n    config = user_config.UserConfig(**CONFIG)\n    print(\"loaded config:\")\n    pp(CONFIG)\n    nmh = NotificationManager()  # Initialize the NotificationManager\n\n    nmh.listen(\n        listeners=listeners_config, from_date=START_DATE,to_date=END_DATE, config=config\n    )  # Start listening\nexcept Exception as e:\n    print(f\"Failed to initialize the Notification Manager: {e}\")","visibility":"show","key":"SepcetpJpd"},{"type":"output","id":"ptMiOgWTSx3nV-DwXcQpB","data":[{"name":"stdout","output_type":"stream","text":"loaded config:\n{'auth_type': 'none',\n 'configuration_engine': {'host': 'aviso.lumi.apps.dte.destination-earth.eu',\n                          'https': True,\n                          'port': 443},\n 'notification_engine': {'host': 'aviso.lumi.apps.dte.destination-earth.eu',\n                         'https': True,\n                         'port': 443},\n 'quiet': True,\n 'remote_schema': True,\n 'schema_parser': 'generic'}\n'ExtremeDT data available=>2026-07-17'\n'ExtremeDT data available=>2026-07-16'\n'ExtremeDT data available=>2026-07-15'\n'ExtremeDT data available=>2026-07-14'\n'ExtremeDT data available=>2026-07-13'\n'ExtremeDT data available=>2026-07-12'\n'ExtremeDT da