key":"GlnnGTfWox"},{"type":"output","id":"t3MiNF7UGObPuVkyL0t8U","data":[],"visibility":"show","key":"NjUQe7BFoA"}],"visibility":"show","key":"eUjv57wCJw"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"text","value":"Authenticate","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"A1Lx4UoFdg"}],"label":"HDA-REST-quick-start.ipynb-Authenticate","identifier":"hda-rest-quick-start.ipynb-authenticate","html_id":"hda-rest-quick-start-ipynb-authenticate","key":"vvcrk5hEI4"}],"key":"wLL5NTEe2b"},{"type":"block","kind":"notebook-code","data":{"tags":[]},"children":[{"type":"code","lang":"python","executable":true,"value":"DESP_USERNAME = input(\"Please input your DESP username or email: \")\nDESP_PASSWORD = getpass(\"Please input your DESP password: \")\n\nauth = deauth.AuthHandler(DESP_USERNAME, DESP_PASSWORD)\naccess_token = auth.get_token()\nif access_token is not None:\n    print(\"DEDL/DESP Access Token Obtained Successfully\")\nelse:\n    print(\"Failed to Obtain DEDL/DESP Access Token\")\n\nauth_headers = {\"Authorization\": f\"Bearer {access_token}\"}","visibility":"show","key":"VgIZ5PE55B"},{"type":"output","id":"WoAOiFMZmz45lNgLl4LX1","data":[{"name":"stdout","output_type":"stream","text":"Please input your DESP username or email:  eum-dedl-user\nPlease input your DESP password:  ········\n"},{"name":"stdout","output_type":"stream","text":"Response code: 200\nDEDL/DESP Access Token Obtained Successfully\n"}],"visibility":"show","key":"OempKZY8el"}],"visibility":"show","key":"IXX0cqNg5k"},{"type":"block","kind":"notebook-content","data":{"tags":[]},"children":[{"type":"heading","depth":3,"position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"text","value":"Search","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"gMlBD7zYJB"}],"label":"HDA-REST-quic