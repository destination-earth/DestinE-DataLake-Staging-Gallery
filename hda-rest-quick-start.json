n## Core\nSTAC_API_URL = f\"{HDA_API_URL}/stac/v2\"\n\n## Collections\nCOLLECTIONS_URL = f\"{STAC_API_URL}/collections\"\nCOLLECTION_BY_ID_URL = f\"{COLLECTIONS_URL}/{COLLECTION_ID}\"\n\n## Items\nCOLLECTION_ITEMS_URL = f\"{COLLECTIONS_URL}/{COLLECTION_ID}/items\"\n\n## Item Search\nSEARCH_URL = f\"{STAC_API_URL}/search\"\n\n## HTTP Success\nHTTP_SUCCESS_CODE = 200","visibility":"show","key":"j8tf6VEtkE"},{"type":"outputs","id":"qVil5i-ZH2S7nbPdZ6O5B","children":[],"visibility":"show","key":"T5xcI5HVNF"}],"visibility":"show","key":"l54hOg7GoN"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Discover data","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"cyfrd6I1up"}],"identifier":"discover-data","label":"Discover data","html_id":"discover-data","implicit":true,"key":"qZ6tBV0vAr"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"Below an example for discovering collections concerning Chlorophyll-a Concentration and algal pigment.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"zS4aZRSIWm"}],"key":"lBtZ4ETUrX"}],"key":"H7nL0vKj64"},{"type":"block","kind":"notebook-code","data":{"tags":[]},"children":[{"type":"code","lang":"python","executable":true,"value":"response = requests.get(COLLECTIONS_URL,params = {\"q\": \"Chlorophyll-a Concentration,algal pigment\"})\n\nJSON(response.json(), expanded=False)","visibility":"show","key":"CLQJyMYlMc"},{"type":"outputs","id":"SWYeT58o7YS0d60LYBdpu","children":[{"type":"output","jupyter_data":{"output_type":"execute_result","execution_count":5,"metadata":{"application/json":{"expanded":false,"root":"root"}},"data":{"application/json":{"content_type":"application/json","hash":"2838aaecfbddd61c0156565a94a33384","path":"/2838aaecfbddd61c0156565a94a33384.json"