, we will present a simple example of how you can access data from DEDL using HDA and what you can do with it. We will demonstrate how to utilize thresholding techniques and compare the values of VV and VH polarizations to analyze urban areas. As an illustration, we will attempt to download Sentinel-1 images containing data of the urban area of Warsaw (Poland).","key":"Ta8yF1GsqC"},{"type":"div","style":{"margin":"6px 0"},"children":[{"type":"span","class":"tag","children":[{"type":"text","value":"HDA","key":"DBSKRlMTEo"}],"key":"fGU72y1hr2"},{"type":"span","class":"tag","children":[{"type":"text","value":"STAC","key":"vYmxKjRaQq"}],"key":"SsAl2kXoG0"},{"type":"span","class":"tag","children":[{"type":"text","value":"Authentication","key":"giGg6134B3"}],"key":"MbD2NAvILR"},{"type":"span","class":"tag","children":[{"type":"text","value":"Access Token","key":"dzO8e6bq0D"}],"key":"alldVaRpLm"}],"key":"WrwkfGUKIY"},{"type":"link","style":{"textDecoration":"none","color":"#1d70b8","fontWeight":"bold"},"url":"/dedl-hda-eo-esa-dat-sentinel-1-l1-grd","children":[{"type":"text","value":"View Notebook","key":"XWGVSRP5Xu"}],"urlSource":"../production/HDA/REST/DEDL-HDA-EO.ESA.DAT.SENTINEL-1.L1_GRD.ipynb","dataUrl":"/dedl-hda-eo-esa-dat-sentinel-1-l1-grd.json","internal":true,"protocol":"file","key":"nFCQwCXYa2"}],"key":"fx4RZ1l6ld"}],"key":"NSlm8rFFEU"}],"key":"uZ3jf8A9or"}],"key":"qxigCjlG4U"}],"key":"bXMXrrofny"},"references":{"cite":{"order":[],"data":{}}},"footer":{},"domain":"http://localhost:3000"}